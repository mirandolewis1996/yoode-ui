{% doc %}
  @prompt
    add a horizontal scroll section where  diff category with image are displaye. when user scroll that section to scroll horizontally using gsap. first display 3 category and reminding ans be displayed when scrolled
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-horizontal-scroll-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-horizontal-scroll-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-horizontal-scroll-header-{{ ai_gen_id }} {
    margin-bottom: 30px;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-horizontal-scroll-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  .ai-horizontal-scroll-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    cursor: grab;
  }

  .ai-horizontal-scroll-wrapper-{{ ai_gen_id }}:active {
    cursor: grabbing;
  }

  .ai-horizontal-scroll-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    will-change: transform;
  }

  .ai-horizontal-scroll-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-horizontal-scroll-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-horizontal-scroll-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-horizontal-scroll-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-horizontal-scroll-image-wrapper-{{ ai_gen_id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-horizontal-scroll-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-horizontal-scroll-category-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_title_size }}px;
    color: {{ block.settings.category_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-horizontal-scroll-category-desc-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_desc_size }}px;
    color: {{ block.settings.category_desc_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-horizontal-scroll-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-horizontal-scroll-item-{{ ai_gen_id }} {
      width: {{ block.settings.card_width | times: 0.8 }}px;
    }

    .ai-horizontal-scroll-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<horizontal-scroll-{{ ai_gen_id }}
  class="ai-horizontal-scroll-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-scroll-speed="{{ block.settings.scroll_speed }}"
>
  <div class="ai-horizontal-scroll-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-horizontal-scroll-header-{{ ai_gen_id }}">
        <h2 class="ai-horizontal-scroll-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="ai-horizontal-scroll-wrapper-{{ ai_gen_id }}">
      <div class="ai-horizontal-scroll-track-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% liquid
            assign category_enabled_key = 'category_' | append: i | append: '_enabled'
            assign category_title_key = 'category_' | append: i | append: '_title'
            assign category_desc_key = 'category_' | append: i | append: '_description'
            assign category_image_key = 'category_' | append: i | append: '_image'
            assign category_link_key = 'category_' | append: i | append: '_link'

            assign category_enabled = block.settings[category_enabled_key]
            assign category_title = block.settings[category_title_key]
            assign category_desc = block.settings[category_desc_key]
            assign category_image = block.settings[category_image_key]
            assign category_link = block.settings[category_link_key]
          %}

          {% if category_enabled %}
            <div class="ai-horizontal-scroll-item-{{ ai_gen_id }}">
              {% if category_link != blank %}
                <a href="{{ category_link }}" class="ai-horizontal-scroll-link-{{ ai_gen_id }}">
              {% endif %}
                <div class="ai-horizontal-scroll-image-wrapper-{{ ai_gen_id }}">
                  {% if category_image %}
                    <img
                      src="{{ category_image | image_url: width: 600 }}"
                      alt="{{ category_title | escape }}"
                      loading="lazy"
                      width="600"
                      height="600"
                      class="ai-horizontal-scroll-image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  {% endif %}
                </div>
                <div class="ai-horizontal-scroll-content-{{ ai_gen_id }}">
                  {% if category_title != blank %}
                    <h3 class="ai-horizontal-scroll-category-title-{{ ai_gen_id }}">{{ category_title }}</h3>
                  {% endif %}
                  {% if category_desc != blank %}
                    <p class="ai-horizontal-scroll-category-desc-{{ ai_gen_id }}">{{ category_desc }}</p>
                  {% endif %}
                </div>
              {% if category_link != blank %}
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</horizontal-scroll-{{ ai_gen_id }}>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<script>
  (function() {
    class HorizontalScroll{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.wrapper = null;
        this.track = null;
        this.scrollSpeed = 1;
        this.isDragging = false;
        this.startX = 0;
        this.scrollLeft = 0;
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-horizontal-scroll-wrapper-{{ ai_gen_id }}');
        this.track = this.querySelector('.ai-horizontal-scroll-track-{{ ai_gen_id }}');
        this.scrollSpeed = parseFloat(this.dataset.scrollSpeed) || 1;

        if (!this.wrapper || !this.track) return;

        this.initGSAP();
        this.initDragScroll();
      }

      initGSAP() {
        const items = this.track.querySelectorAll('.ai-horizontal-scroll-item-{{ ai_gen_id }}');
        if (items.length === 0) return;

        const trackWidth = this.track.scrollWidth;
        const wrapperWidth = this.wrapper.offsetWidth;
        const scrollDistance = trackWidth - wrapperWidth;

        if (scrollDistance <= 0) return;

        gsap.registerPlugin(ScrollTrigger);

        gsap.to(this.track, {
          x: -scrollDistance,
          ease: 'none',
          scrollTrigger: {
            trigger: this.wrapper,
            start: 'top center',
            end: () => '+=' + (scrollDistance * this.scrollSpeed),
            scrub: 1,
            pin: false,
            invalidateOnRefresh: true
          }
        });
      }

      initDragScroll() {
        this.wrapper.addEventListener('mousedown', this.handleMouseDown.bind(this));
        this.wrapper.addEventListener('mouseleave', this.handleMouseUp.bind(this));
        this.wrapper.addEventListener('mouseup', this.handleMouseUp.bind(this));
        this.wrapper.addEventListener('mousemove', this.handleMouseMove.bind(this));

        this.wrapper.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
        this.wrapper.addEventListener('touchend', this.handleTouchEnd.bind(this));
        this.wrapper.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: true });
      }

      handleMouseDown(e) {
        this.isDragging = true;
        this.startX = e.pageX - this.wrapper.offsetLeft;
        const transform = window.getComputedStyle(this.track).transform;
        if (transform !== 'none') {
          const matrix = new DOMMatrix(transform);
          this.scrollLeft = -matrix.m41;
        } else {
          this.scrollLeft = 0;
        }
      }

      handleMouseUp() {
        this.isDragging = false;
      }

      handleMouseMove(e) {
        if (!this.isDragging) return;
        e.preventDefault();
        const x = e.pageX - this.wrapper.offsetLeft;
        const walk = (x - this.startX) * 2;
        const newX = this.scrollLeft - walk;
        const maxScroll = this.track.scrollWidth - this.wrapper.offsetWidth;
        const clampedX = Math.max(0, Math.min(newX, maxScroll));
        gsap.to(this.track, { x: -clampedX, duration: 0.3, overwrite: true });
      }

      handleTouchStart(e) {
        this.isDragging = true;
        this.startX = e.touches[0].pageX - this.wrapper.offsetLeft;
        const transform = window.getComputedStyle(this.track).transform;
        if (transform !== 'none') {
          const matrix = new DOMMatrix(transform);
          this.scrollLeft = -matrix.m41;
        } else {
          this.scrollLeft = 0;
        }
      }

      handleTouchEnd() {
        this.isDragging = false;
      }

      handleTouchMove(e) {
        if (!this.isDragging) return;
        const x = e.touches[0].pageX - this.wrapper.offsetLeft;
        const walk = (x - this.startX) * 2;
        const newX = this.scrollLeft - walk;
        const maxScroll = this.track.scrollWidth - this.wrapper.offsetWidth;
        const clampedX = Math.max(0, Math.min(newX, maxScroll));
        gsap.to(this.track, { x: -clampedX, duration: 0.3, overwrite: true });
      }
    }

    customElements.define('horizontal-scroll-{{ ai_gen_id }}', HorizontalScroll{{ ai_gen_id }});
  })();
</script>

