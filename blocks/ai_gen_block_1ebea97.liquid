{% doc %}
  @prompt
    add a holographic product card which display 4 column layout and should be responsive and make it slide automaticaly with some gsap effect , the section should have a title as other sections. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-holographic-cards-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-holographic-cards__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-holographic-cards__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: 40px;
  }

  .ai-holographic-cards__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-holographic-cards__carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-holographic-cards__track-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_list.count }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    will-change: transform;
  }

  .ai-holographic-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background: {{ block.settings.card_background }};
    cursor: pointer;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .ai-holographic-card__inner-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-holographic-card__holographic-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(255, 0, 255, 0.1) 0%,
      rgba(0, 255, 255, 0.1) 25%,
      rgba(255, 255, 0, 0.1) 50%,
      rgba(0, 255, 0, 0.1) 75%,
      rgba(255, 0, 0, 0.1) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  .ai-holographic-card-{{ ai_gen_id }}:hover .ai-holographic-card__holographic-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.holographic_intensity }};
  }

  .ai-holographic-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 16px;
    background-color: #f4f4f4;
  }

  .ai-holographic-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-holographic-card-{{ ai_gen_id }}:hover .ai-holographic-card__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-holographic-card__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-holographic-card__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-holographic-card__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
  }

  .ai-holographic-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-holographic-card__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 500;
  }

  .ai-holographic-card__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    z-index: 3;
  }

  .ai-holographic-cards__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .ai-holographic-cards__control-btn-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.control_button_bg }};
    color: {{ block.settings.control_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-holographic-cards__control-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.control_button_hover_bg }};
    transform: scale(1.1);
  }

  .ai-holographic-cards__control-btn-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-holographic-cards__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .ai-holographic-cards__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-holographic-cards__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  @media screen and (max-width: 1200px) {
    .ai-holographic-cards__track-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 990px) {
    .ai-holographic-cards__track-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-holographic-cards__track-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-holographic-cards__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<holographic-product-cards-{{ ai_gen_id }}
  class="ai-holographic-cards-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-holographic-cards__container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-holographic-cards__header-{{ ai_gen_id }}">
        <h2 class="ai-holographic-cards__title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      </div>
    {% endif %}

    <div class="ai-holographic-cards__carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-holographic-cards__track-{{ ai_gen_id }}">
        {% if block.settings.products_list.count > 0 %}
          {% for product in block.settings.products_list %}
            <div class="ai-holographic-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
              <div class="ai-holographic-card__inner-{{ ai_gen_id }}">
                <div class="ai-holographic-card__holographic-overlay-{{ ai_gen_id }}"></div>
                
                {% if product.compare_at_price > product.price %}
                  <div class="ai-holographic-card__badge-{{ ai_gen_id }}">
                    Sale
                  </div>
                {% endif %}

                <a href="{{ product.url }}" class="ai-holographic-card__image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-holographic-card__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="ai-holographic-card__image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </a>

                <div class="ai-holographic-card__content-{{ ai_gen_id }}">
                  <h3 class="ai-holographic-card__title-{{ ai_gen_id }}">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>
                  <div class="ai-holographic-card__price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..8) %}
            <div class="ai-holographic-card-{{ ai_gen_id }}">
              <div class="ai-holographic-card__inner-{{ ai_gen_id }}">
                <div class="ai-holographic-card__holographic-overlay-{{ ai_gen_id }}"></div>
                
                <div class="ai-holographic-card__image-wrapper-{{ ai_gen_id }}">
                  <div class="ai-holographic-card__image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                </div>

                <div class="ai-holographic-card__content-{{ ai_gen_id }}">
                  <h3 class="ai-holographic-card__title-{{ ai_gen_id }}">
                    Product {{ i }}
                  </h3>
                  <div class="ai-holographic-card__price-{{ ai_gen_id }}">
                    ₹999
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    {% if block.settings.show_controls %}
      <div class="ai-holographic-cards__controls-{{ ai_gen_id }}">
        <button class="ai-holographic-cards__control-btn-{{ ai_gen_id }} ai-holographic-cards__prev-{{ ai_gen_id }}" aria-label="Previous">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="ai-holographic-cards__control-btn-{{ ai_gen_id }} ai-holographic-cards__next-{{ ai_gen_id }}" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-holographic-cards__dots-{{ ai_gen_id }}">
        {% assign total_products = block.settings.products_list.count %}
        {% if total_products == 0 %}
          {% assign total_products = 8 %}
        {% endif %}
        {% for i in (1..total_products) %}
          <div class="ai-holographic-cards__dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</holographic-product-cards-{{ ai_gen_id }}>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<script>
  (function() {
    class HolographicProductCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
        this.isAnimating = false;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-holographic-cards__track-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-holographic-card-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-holographic-cards__prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-holographic-cards__next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-holographic-cards__dot-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 3000;

        this.setupEventListeners();
        this.initializeCards();
        
        if (this.autoplay) {
          this.startAutoplay();
        }

        this.setupHolographicEffect();
      }

      setupEventListeners() {
        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => this.navigate('prev'));
        }
        
        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => this.navigate('next'));
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.addEventListener('mouseenter', () => this.pauseAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) {
            this.startAutoplay();
          }
        });
      }

      initializeCards() {
        gsap.set(this.cards, {
          opacity: 0,
          y: 50,
          scale: 0.9
        });

        gsap.to(this.cards, {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.8,
          stagger: 0.1,
          ease: 'power3.out'
        });
      }

      setupHolographicEffect() {
        this.cards.forEach(card => {
          const overlay = card.querySelector('.ai-holographic-card__holographic-overlay-{{ ai_gen_id }}');
          
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            const rotateX = (y - centerY) / 10;
            const rotateY = (centerX - x) / 10;
            
            gsap.to(card, {
              rotateX: rotateX,
              rotateY: rotateY,
              duration: 0.3,
              ease: 'power2.out'
            });

            const gradientX = (x / rect.width) * 100;
            const gradientY = (y / rect.height) * 100;
            
            overlay.style.background = `radial-gradient(circle at ${gradientX}% ${gradientY}%, rgba(255, 0, 255, 0.3), rgba(0, 255, 255, 0.2), rgba(255, 255, 0, 0.1), transparent)`;
          });

          card.addEventListener('mouseleave', () => {
            gsap.to(card, {
              rotateX: 0,
              rotateY: 0,
              duration: 0.5,
              ease: 'power2.out'
            });
          });
        });
      }

      navigate(direction) {
        if (this.isAnimating) return;
        
        this.isAnimating = true;
        const totalCards = this.cards.length;
        
        if (direction === 'next') {
          this.currentIndex = (this.currentIndex + 1) % totalCards;
        } else {
          this.currentIndex = (this.currentIndex - 1 + totalCards) % totalCards;
        }

        this.animateCards(direction);
        this.updateDots();
      }

      goToSlide(index) {
        if (this.isAnimating || index === this.currentIndex) return;
        
        const direction = index > this.currentIndex ? 'next' : 'prev';
        this.currentIndex = index;
        this.animateCards(direction);
        this.updateDots();
      }

      animateCards(direction) {
        const xOffset = direction === 'next' ? -100 : 100;
        
        gsap.to(this.cards, {
          x: xOffset,
          opacity: 0,
          duration: 0.6,
          ease: 'power2.inOut',
          onComplete: () => {
            gsap.set(this.cards, { x: -xOffset });
            gsap.to(this.cards, {
              x: 0,
              opacity: 1,
              duration: 0.6,
              ease: 'power2.out',
              stagger: 0.05,
              onComplete: () => {
                this.isAnimating = false;
              }
            });
          }
        });
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        this.pauseAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.navigate('next');
        }, this.autoplaySpeed);
      }

      pauseAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.pauseAutoplay();
      }
    }

    customElements.define('holographic-product-cards-{{ ai_gen_id }}', HolographicProductCards{{ ai_gen_id }});
  })();
</script>

