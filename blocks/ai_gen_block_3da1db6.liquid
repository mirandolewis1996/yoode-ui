{% doc %}
  @prompt
    add a popup modal to get mobile number and name from vistor so they can avail a 20% offer, the filled number and name can be create as customer inside shopify.when this customer purchase there first product they should get 20% discount
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-discount-popup-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .ai-discount-popup-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-discount-popup-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-discount-popup-content-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.popup_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    max-width: {{ block.settings.popup_width }}px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    padding: {{ block.settings.padding }}px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .ai-discount-popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .ai-discount-popup-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-discount-popup-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 20px;
  }

  .ai-discount-popup-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-discount-popup-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.secondary_text_color }};
    margin: 0;
  }

  .ai-discount-popup-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ai-discount-popup-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ai-discount-popup-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-discount-popup-input-{{ ai_gen_id }} {
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-discount-popup-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.button_bg_color }};
  }

  .ai-discount-popup-button-{{ ai_gen_id }} {
    padding: 15px 30px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-discount-popup-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-discount-popup-button-{{ ai_gen_id }}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ai-discount-popup-message-{{ ai_gen_id }} {
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
    text-align: center;
    margin-top: 10px;
  }

  .ai-discount-popup-message-{{ ai_gen_id }}.success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .ai-discount-popup-message-{{ ai_gen_id }}.error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .ai-discount-popup-terms-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.secondary_text_color }};
    text-align: center;
    margin-top: 15px;
  }

  @media screen and (max-width: 749px) {
    .ai-discount-popup-content-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-discount-popup-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-discount-popup-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }
{% endstyle %}

<discount-popup-{{ ai_gen_id }}
  class="ai-discount-popup-{{ ai_gen_id }}"
  data-delay="{{ block.settings.popup_delay }}"
  data-show-once="{{ block.settings.show_once }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-discount-popup-overlay-{{ ai_gen_id }}"></div>
  
  <div class="ai-discount-popup-content-{{ ai_gen_id }}">
    <button
      class="ai-discount-popup-close-{{ ai_gen_id }}"
      aria-label="Close popup"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="ai-discount-popup-header-{{ ai_gen_id }}">
      {%- if block.settings.title != blank -%}
        <h2 class="ai-discount-popup-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {%- endif -%}
      {%- if block.settings.subtitle != blank -%}
        <p class="ai-discount-popup-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- form 'customer' -%}
      <input type="hidden" name="form_type" value="create_customer">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="customer[tags]" value="discount_20_percent">
      <input type="hidden" name="customer[note]" value="First purchase 20% discount eligible">
      
      <div class="ai-discount-popup-form-{{ ai_gen_id }}">
        <div class="ai-discount-popup-field-{{ ai_gen_id }}">
          <label class="ai-discount-popup-label-{{ ai_gen_id }}" for="ai-popup-name-{{ ai_gen_id }}">
            Name
          </label>
          <input
            type="text"
            id="ai-popup-name-{{ ai_gen_id }}"
            name="customer[first_name]"
            class="ai-discount-popup-input-{{ ai_gen_id }}"
            placeholder="Enter your name"
            required
            aria-required="true"
          >
        </div>

        <div class="ai-discount-popup-field-{{ ai_gen_id }}">
          <label class="ai-discount-popup-label-{{ ai_gen_id }}" for="ai-popup-phone-{{ ai_gen_id }}">
            Mobile Number
          </label>
          <input
            type="tel"
            id="ai-popup-phone-{{ ai_gen_id }}"
            name="customer[phone]"
            class="ai-discount-popup-input-{{ ai_gen_id }}"
            placeholder="+91 1234567890"
            required
            aria-required="true"
            pattern="[+]?[0-9\s\-()]+"
          >
        </div>

        <div class="ai-discount-popup-field-{{ ai_gen_id }}">
          <label class="ai-discount-popup-label-{{ ai_gen_id }}" for="ai-popup-email-{{ ai_gen_id }}">
            Email
          </label>
          <input
            type="email"
            id="ai-popup-email-{{ ai_gen_id }}"
            name="customer[email]"
            class="ai-discount-popup-input-{{ ai_gen_id }}"
            placeholder="your@email.com"
            required
            aria-required="true"
            autocomplete="email"
          >
        </div>

        <button
          type="submit"
          class="ai-discount-popup-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </button>

        {%- if form.errors -%}
          <div class="ai-discount-popup-message-{{ ai_gen_id }} error">
            {%- for field in form.errors -%}
              {{ form.errors.messages[field] }}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="ai-discount-popup-message-{{ ai_gen_id }} success">
            {{ block.settings.success_message }}
          </div>
        {%- endif -%}
      </div>
    {%- endform -%}

    {%- if block.settings.terms_text != blank -%}
      <div class="ai-discount-popup-terms-{{ ai_gen_id }}">
        {{ block.settings.terms_text }}
      </div>
    {%- endif -%}
  </div>
</discount-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class DiscountPopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.delay = parseInt(this.dataset.delay) * 1000;
        this.showOnce = this.dataset.showOnce === 'true';
        this.storageKey = 'ai-discount-popup-{{ ai_gen_id }}-shown';
      }

      connectedCallback() {
        this.closeButton = this.querySelector('.ai-discount-popup-close-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-discount-popup-overlay-{{ ai_gen_id }}');
        this.form = this.querySelector('form');
        
        this.setupEventListeners();
        this.checkAndShowPopup();
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => this.closePopup());
        this.overlay.addEventListener('click', () => this.closePopup());
        
        this.form.addEventListener('submit', (e) => {
          this.handleSubmit(e);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.classList.contains('active')) {
            this.closePopup();
          }
        });
      }

      checkAndShowPopup() {
        if (this.showOnce) {
          const hasShown = localStorage.getItem(this.storageKey);
          if (hasShown) {
            return;
          }
        }

        setTimeout(() => {
          this.showPopup();
        }, this.delay);
      }

      showPopup() {
        this.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closePopup() {
        this.classList.remove('active');
        document.body.style.overflow = '';
        
        if (this.showOnce) {
          localStorage.setItem(this.storageKey, 'true');
        }
      }

      handleSubmit(e) {
        const submitButton = this.form.querySelector('button[type="submit"]');
        submitButton.disabled = true;
        submitButton.textContent = 'Submitting...';
        
        setTimeout(() => {
          if (this.showOnce) {
            localStorage.setItem(this.storageKey, 'true');
          }
        }, 1000);
      }
    }

    customElements.define('discount-popup-{{ ai_gen_id }}', DiscountPopup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Discount popup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Get 20% OFF Your First Order!"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Sign up now and enjoy an exclusive discount on your first purchase"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Claim My 20% Discount"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! Check your email for your 20% discount code."
    },
    {
      "type": "textarea",
      "id": "terms_text",
