{% doc %}
  @prompt
    add a holographic product card which display 4 column layout in a row and should be responsive and make it slide automaticaly with some gsap effect , the section should have a title as other sections.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-holographic-cards-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-holographic-cards__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-holographic-cards__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-holographic-cards__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
  }

  .ai-holographic-cards__slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-holographic-cards__slider-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    will-change: transform;
  }

  .ai-holographic-card-{{ ai_gen_id }} {
    flex: 0 0 calc(25% - 18px);
    min-width: calc(25% - 18px);
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 2px;
    transition: transform 0.3s ease;
  }

  .ai-holographic-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
  }

  .ai-holographic-card__inner-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: calc({{ block.settings.card_border_radius }}px - 2px);
    padding: 20px;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-holographic-card__inner-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      45deg,
      transparent 30%,
      rgba(255, 255, 255, 0.1) 50%,
      transparent 70%
    );
    transform: rotate(45deg);
    animation: ai-holographic-shine-{{ ai_gen_id }} 3s infinite;
  }

  @keyframes ai-holographic-shine-{{ ai_gen_id }} {
    0% {
      transform: translateX(-100%) translateY(-100%) rotate(45deg);
    }
    100% {
      transform: translateX(100%) translateY(100%) rotate(45deg);
    }
  }

  .ai-holographic-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    margin-bottom: 16px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background: linear-gradient(135deg, 
      rgba(102, 126, 234, 0.3) 0%, 
      rgba(118, 75, 162, 0.3) 50%,
      rgba(237, 100, 166, 0.3) 100%
    );
  }

  .ai-holographic-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-holographic-card__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-holographic-card__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-holographic-card__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
  }

  .ai-holographic-card__product-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-holographic-card__product-price-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 500;
    color: {{ block.settings.price_color }};
    margin-bottom: 12px;
  }

  .ai-holographic-card__product-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 500;
    transition: background-color 0.3s ease;
  }

  .ai-holographic-card__product-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-holographic-card__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 20px;
    color: {{ block.settings.card_text_color }};
    opacity: 0.6;
    font-style: italic;
  }

  @media screen and (max-width: 1200px) {
    .ai-holographic-card-{{ ai_gen_id }} {
      flex: 0 0 calc(33.333% - 16px);
      min-width: calc(33.333% - 16px);
    }
  }

  @media screen and (max-width: 768px) {
    .ai-holographic-card-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 12px);
      min-width: calc(50% - 12px);
    }

    .ai-holographic-cards-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-holographic-cards__header-{{ ai_gen_id }} {
      margin-bottom: 30px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-holographic-card-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - 0px);
      min-width: calc(100% - 0px);
    }

    .ai-holographic-cards__slider-{{ ai_gen_id }} {
      gap: 16px;
    }
  }
{% endstyle %}

<holographic-product-cards-{{ ai_gen_id }}
  class="ai-holographic-cards-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-speed="{{ block.settings.slide_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-holographic-cards__container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-holographic-cards__header-{{ ai_gen_id }}">
        <h2 class="ai-holographic-cards__title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      </div>
    {% endif %}

    <div class="ai-holographic-cards__slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-holographic-cards__slider-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% liquid
            assign product_key = 'product_' | append: i
            assign product = block.settings[product_key]
          %}

          <div class="ai-holographic-card-{{ ai_gen_id }}">
            <div class="ai-holographic-card__inner-{{ ai_gen_id }}">
              <div class="ai-holographic-card__image-wrapper-{{ ai_gen_id }}">
                {% if product != blank and product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 500 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-holographic-card__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="500"
                    height="500"
                  >
                {% else %}
                  <div class="ai-holographic-card__image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-holographic-card__content-{{ ai_gen_id }}">
                {% if product != blank %}
                  <h3 class="ai-holographic-card__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <div class="ai-holographic-card__product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                  <a
                    href="{{ product.url }}"
                    class="ai-holographic-card__product-link-{{ ai_gen_id }}"
                  >
                    {{ block.settings.button_text }}
                  </a>
                {% else %}
                  <div class="ai-holographic-card__empty-{{ ai_gen_id }}">
                    Select a product
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</holographic-product-cards-{{ ai_gen_id }}>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

<script>
  (function() {
    class HolographicProductCards{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.slider = this.querySelector('.ai-holographic-cards__slider-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-holographic-card-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.speed = parseFloat(this.dataset.speed) || 2;
        this.animationId = null;
      }

      connectedCallback() {
        if (this.cards.length === 0) return;

        this.cloneCards();
        this.setupGSAPAnimation();
        this.setupHoverEffects();
      }

      cloneCards() {
        const cardsArray = Array.from(this.cards);
        cardsArray.forEach(card => {
          const clone = card.cloneNode(true);
          this.slider.appendChild(clone);
        });
      }

      setupGSAPAnimation() {
        if (!this.autoplay) return;

        const totalWidth = this.slider.scrollWidth / 2;
        
        gsap.set(this.slider, { x: 0 });

        const animation = gsap.to(this.slider, {
          x: -totalWidth,
          duration: this.speed * this.cards.length,
          ease: 'none',
          repeat: -1,
          modifiers: {
            x: gsap.utils.unitize(x => parseFloat(x) % totalWidth)
          }
        });

        this.slider.addEventListener('mouseenter', () => {
          gsap.to(animation, { timeScale: 0.3, duration: 0.5 });
        });

        this.slider.addEventListener('mouseleave', () => {
          gsap.to(animation, { timeScale: 1, duration: 0.5 });
        });
      }

      setupHoverEffects() {
        this.querySelectorAll('.ai-holographic-card-{{ ai_gen_id }}').forEach(card => {
          card.addEventListener('mouseenter', (e) => {
            gsap.to(card, {
              scale: 1.05,
              duration: 0.3,
              ease: 'power2.out'
            });
          });

          card.addEventListener('mouseleave', (e) => {
            gsap.to(card, {
              scale: 1,
              duration: 0.3,
              ease: 'power2.out'
            });
          });

          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            
            const rotateX = (y - centerY) / 10;
            const rotateY = (centerX - x) / 10;

            gsap.to(card, {
              rotationX: rotateX,
              rotationY: rotateY,
              duration: 0.3,
              ease: 'power2.out',
              transformPerspective: 1000
            });
          });

          card.addEventListener('mouseleave', () => {
            gsap.to(card, {
              rotationX: 0,
              rotationY: 0,
              duration: 0.5,
              ease: 'power2.out'
            });
          });
        });
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
      }
    }

    customElements.define('holographic-product-cards-{{ ai_gen_id }}', HolographicProductCards{{ ai_gen_id }});
  })();
</script>

