{% doc %}
  @prompt
    add a customizable vertical timelines with title ,subtitle,date, and description , first time line can be on right and next on of the left , so the timeline line will be in middle .
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.container_padding }}px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-timeline-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-timeline-main-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_title_size }}px;
    color: {{ block.settings.main_title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
  }

  .ai-timeline-main-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_subtitle_size }}px;
    color: {{ block.settings.main_subtitle_color }};
    margin: 0;
  }

  .ai-timeline-wrapper-{{ ai_gen_id }} {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: {{ block.settings.line_width }}px;
    background-color: {{ block.settings.line_color }};
    transform: translateX(-50%);
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    padding-bottom: {{ block.settings.item_spacing }}px;
    display: flex;
    justify-content: flex-end;
    width: 100%;
  }

  .ai-timeline-item-{{ ai_gen_id }}:last-child {
    padding-bottom: 0;
  }

  .ai-timeline-item-{{ ai_gen_id }}:nth-child(even) {
    justify-content: flex-start;
  }

  .ai-timeline-dot-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    top: {{ block.settings.dot_top_offset }}px;
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: {{ block.settings.dot_border_width }}px solid {{ block.settings.dot_border_color }};
    transform: translateX(-50%);
    z-index: 2;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    width: calc(50% - {{ block.settings.content_gap }}px);
    position: relative;
  }

  .ai-timeline-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
    margin-bottom: {{ block.settings.date_spacing }}px;
    font-weight: 600;
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: 600;
  }

  .ai-timeline-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 {{ block.settings.subtitle_spacing }}px 0;
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-timeline-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-timeline-wrapper-{{ ai_gen_id }} {
      padding-left: 30px;
    }

    .ai-timeline-line-{{ ai_gen_id }} {
      left: 8px;
      transform: none;
    }

    .ai-timeline-item-{{ ai_gen_id }} {
      justify-content: flex-start;
      padding-left: 40px;
    }

    .ai-timeline-item-{{ ai_gen_id }}:nth-child(even) {
      justify-content: flex-start;
    }

    .ai-timeline-dot-{{ ai_gen_id }} {
      left: 8px;
      transform: translateX(-50%);
    }

    .ai-timeline-content-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<vertical-timeline-{{ ai_gen_id }} class="ai-timeline-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_title != blank or block.settings.main_subtitle != blank %}
    <div class="ai-timeline-header-{{ ai_gen_id }}">
      {% if block.settings.main_title != blank %}
        <h2 class="ai-timeline-main-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
      {% endif %}
      {% if block.settings.main_subtitle != blank %}
        <p class="ai-timeline-main-subtitle-{{ ai_gen_id }}">{{ block.settings.main_subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-timeline-wrapper-{{ ai_gen_id }}">
    <div class="ai-timeline-line-{{ ai_gen_id }}"></div>

    {% for i in (1..5) %}
      {% liquid
        assign item_enabled_key = 'item_' | append: i | append: '_enabled'
        assign item_date_key = 'item_' | append: i | append: '_date'
        assign item_title_key = 'item_' | append: i | append: '_title'
        assign item_subtitle_key = 'item_' | append: i | append: '_subtitle'
        assign item_description_key = 'item_' | append: i | append: '_description'

        assign item_enabled = block.settings[item_enabled_key]
        assign item_date = block.settings[item_date_key]
        assign item_title = block.settings[item_title_key]
        assign item_subtitle = block.settings[item_subtitle_key]
        assign item_description = block.settings[item_description_key]
      %}

      {% if item_enabled %}
        <div class="ai-timeline-item-{{ ai_gen_id }}">
          <div class="ai-timeline-dot-{{ ai_gen_id }}"></div>
          <div class="ai-timeline-content-{{ ai_gen_id }}">
            {% if item_date != blank %}
              <div class="ai-timeline-date-{{ ai_gen_id }}">{{ item_date }}</div>
            {% endif %}
            {% if item_title != blank %}
              <h3 class="ai-timeline-title-{{ ai_gen_id }}">{{ item_title }}</h3>
            {% endif %}
            {% if item_subtitle != blank %}
              <p class="ai-timeline-subtitle-{{ ai_gen_id }}">{{ item_subtitle }}</p>
            {% endif %}
            {% if item_description != blank %}
              <div class="ai-timeline-description-{{ ai_gen_id }}">{{ item_description }}</div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</vertical-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class VerticalTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initTimeline();
      }

      initTimeline() {
        const items = this.querySelectorAll('.ai-timeline-item-{{ ai_gen_id }}');
        
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
              }
            });
          }, {
            threshold: 0.1
          });

          items.forEach((item, index) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(20px)';
            item.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            item.style.transitionDelay = (index * 0.1) + 's';
            observer.observe(item);
          });
        }
      }
    }

    customElements.define('vertical-timeline-{{ ai_gen_id }}', VerticalTimeline{{ ai_gen_id }});
  })();
</script>

