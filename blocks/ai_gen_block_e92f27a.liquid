      "label": "Phone input placeholder",
      "default": "Enter your mobile number"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Claim offer"
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! Your offer code will be sent shortly."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Something went wrong. Please try again."
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show disclaimer",
      "default": true
    },
    {
      "type": "textarea",
