{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

<!-- What Can We Build Section -->
<section class="yoode-build-section section-{{ section.id }}-padding section-padding">
  <div class="yoode-container">
    {% if section.settings.heading != blank or section.settings.subtitle != blank %}
      <header class="yoode-build-header">
        {% if section.settings.heading != blank %}
          <h2 class="yoode-build-title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="yoode-build-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="yoode-build-grid">
        {% for block in section.blocks %}
          <article class="yoode-build-card" {{ block.shopify_attributes }}>
            <div class="yoode-build-card-media">
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 600 | image_tag: alt: block.settings.card_title, class: "yoode-build-card-img" }}
              {% endif %}
            </div>
            <div class="yoode-build-card-content">
              {% if block.settings.category != blank %}
                <span class="yoode-build-category">{{ block.settings.category }}</span>
              {% endif %}
              {% if block.settings.card_title != blank %}
                <h3 class="yoode-build-card-title">{{ block.settings.card_title }}</h3>
              {% endif %}
              {% if block.settings.card_text != blank %}
                <p class="yoode-build-card-text">{{ block.settings.card_text }}</p>
              {% endif %}
              {% if block.settings.link_text != blank %}
                <a href="{{ block.settings.link_url }}" class="yoode-build-card-link">
                  {{ block.settings.link_text }}
                  <svg class="yoode-build-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

