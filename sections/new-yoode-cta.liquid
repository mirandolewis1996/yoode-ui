{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

<!-- Call to Action Section -->
<section class="yoode-cta-section section-{{ section.id }}-padding section-padding">
  <div class="yoode-cta-container">
    <div class="yoode-cta-border{% unless section.settings.show_border %} yoode-cta-border--flat{% endunless %}">
    {% if section.settings.heading != blank %}
      <h2 class="yoode-cta-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="yoode-cta-description">{{ section.settings.description }}</p>
    {% endif %}

    {% if section.settings.primary_button_text != blank or section.settings.secondary_button_text != blank %}
      <div class="yoode-cta-buttons">
        {% if section.settings.primary_button_text != blank %}
          <a href="{{ section.settings.primary_button_link }}" class="yoode-btn yoode-btn-primary">
            {{ section.settings.primary_button_text }}
            {% if section.settings.show_arrow %}
              <span class="yoode-btn-arrow">↗</span>
            {% endif %}
          </a>
        {% endif %}

        {% if section.settings.secondary_button_text != blank %}
          <a href="{{ section.settings.secondary_button_link }}" class="yoode-btn yoode-btn-secondary">
            {{ section.settings.secondary_button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
  </div>
</section>

{% schema %}
