        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "xl",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "text",
          "id": "location_name",
          "default": "City Name",
          "label": "Location Name"
        },
        {
          "type": "text",
          "id": "status_text",
          "default": "Open now",
          "label": "Status Badge Text"
        },
        {
          "type": "text",
          "id": "address",
          "default": "Experience Centre Address",
          "label": "Address"
        },
        {
