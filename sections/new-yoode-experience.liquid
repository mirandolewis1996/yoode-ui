          "id": "hours",
          "default": "Open Mon–Sat · 10am–7pm",
          "label": "Hours Text"
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "button_1_text",
          "default": "Get directions",
          "label": "Primary Button Text"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "button_2_text",
          "default": "Book a visit",
          "label": "Secondary Button Text"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Yoode Experience",
      "settings": {
        "heading": "See it. Touch it. Make it yours.",
        "subtitle": "Two Experience Centres — Chennai and Bangalore — where you can design your merchandise with us, in person."
      },
      "blocks": [
        {
          "type": "location",
          "settings": {
            "location_name": "Chennai",
            "status_text": "Open now",
            "address": "Koramangala-style Experience Centre",
            "hours": "Open Mon–Sat · 10am–7pm",
            "button_1_text": "Get directions",
            "button_2_text": "Book a visit"
          }
        },
        {
          "type": "location",
          "settings": {
            "location_name": "Bangalore",
            "status_text": "Open now",
            "address": "5th Block, Koramangala Industrial Layout",
            "hours": "Open Mon–Sat · 10am–7pm",
            "button_1_text": "Get directions",
            "button_2_text": "Book a visit"
          }
        }
      ]
    }
  ]
}
{% endschema %}
