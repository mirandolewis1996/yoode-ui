{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

{%- liquid
  # Laptop and tablet step down from the desktop count automatically, but never
  # drop below the mobile count
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile

  assign columns_laptop = columns_desktop
  if columns_laptop > 4
    assign columns_laptop = 4
  endif
  if columns_laptop < columns_mobile
    assign columns_laptop = columns_mobile
  endif

  assign columns_tablet = columns_desktop
  if columns_tablet > 3
    assign columns_tablet = 3
  endif
  if columns_tablet < columns_mobile
    assign columns_tablet = columns_mobile
  endif
-%}

<!-- Most Loved Products Section -->
<section class="yoode-loved-products section-{{ section.id }}-padding section-padding">
  <div class="yoode-container">
    {% if section.settings.heading != blank or section.settings.subtitle != blank %}
      <header class="yoode-products-header">
        {% if section.settings.heading != blank %}
          <h2 class="yoode-products-title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="yoode-products-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="yoode-products-grid"
        style="
          --yoode-prod-cols-desktop: {{ columns_desktop }};
          --yoode-prod-cols-laptop: {{ columns_laptop }};
          --yoode-prod-cols-tablet: {{ columns_tablet }};
          --yoode-prod-cols-mobile: {{ columns_mobile }};
        "
      >
        {% for block in section.blocks %}
          {% liquid
            assign product = block.settings.product
            if product != blank
              assign product_image = product.featured_image
              assign product_name = product.title
              assign product_url = product.url
              assign product_price = product.price | money
            else
              assign product_image = block.settings.image
              assign product_name = block.settings.product_name
              assign product_url = block.settings.button_link
              assign product_price = block.settings.price_text
            endif
          %}
          <article class="yoode-product-card" {{ block.shopify_attributes }}>
            <div class="yoode-product-media">
              {% if product_image %}
                <a href="{{ product_url }}" style="height: 100%;">
                {{ product_image | image_url: width: 500 | image_tag: alt: product_name, class: "yoode-product-img" }}
                 </a>
              {% endif %}
            </div>
            <div class="yoode-product-content">
              {% if product_name != blank %}
                <h3 class="yoode-product-name">{{ product_name }}</h3>
              {% endif %}
              {% if product_price != blank %}
                <p class="yoode-product-price">{{ product_price }}</p>
              {% endif %}
              {% if block.settings.button_text != blank %}
                <a href="{{ product_url }}" class="yoode-product-btn">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

