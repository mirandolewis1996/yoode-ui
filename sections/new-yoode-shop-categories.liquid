{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

{%- liquid
  # Tablet sits between the two chosen counts, capped at 3 so cards never get cramped
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign columns_tablet = columns_desktop
  if columns_tablet > 3
    assign columns_tablet = 3
  endif
  if columns_tablet < columns_mobile
    assign columns_tablet = columns_mobile
  endif
-%}

<!-- Shop by Category Section -->
<section class="yoode-shop-categories section-{{ section.id }}-padding section-padding">
  <div class="yoode-container">
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="yoode-shop-header">
        {% if section.settings.title != blank %}
          <h2 class="yoode-shop-title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="yoode-shop-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="yoode-categories-grid"
        style="
          --yoode-cat-cols-desktop: {{ columns_desktop }};
          --yoode-cat-cols-tablet: {{ columns_tablet }};
          --yoode-cat-cols-mobile: {{ columns_mobile }};
        "
      >
        {% for block in section.blocks %}
          {% if block.settings.category_name != blank %}
            {%- capture category_card_inner -%}
              <div class="yoode-category-image">
                {% if block.settings.image %}
                  {{ block.settings.image | image_url: width: 600 | image_tag: alt: block.settings.category_name }}
                {% comment %} {% else %}
                  <img src="https://via.placeholder.com/300x200" alt="{{ block.settings.category_name }}" /> {% endcomment %}
                {% endif %}
              </div>
              <h3 class="yoode-category-name">{{ block.settings.category_name }}</h3>
            {%- endcapture -%}

            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="yoode-category-card" {{ block.shopify_attributes }}>
                {{ category_card_inner }}
              </a>
            {% else %}
              <div class="yoode-category-card" {{ block.shopify_attributes }}>
                {{ category_card_inner }}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

