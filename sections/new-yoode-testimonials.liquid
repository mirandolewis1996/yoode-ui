{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

<!-- Testimonials Section -->
<div class="yoode-testimonials-section section-{{ section.id }}-padding section-padding">
  <div class="yoode-container">
    {% if section.settings.heading != blank or section.settings.subtitle != blank %}
      <header class="yoode-testimonials-header">
        {% if section.settings.heading != blank %}
          <h2 class="yoode-testimonials-title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="yoode-testimonials-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="yoode-testimonials-grid">
        {% for block in section.blocks %}
          {% if block.settings.quote != blank %}
            <article class="yoode-testimonial-card">
              <blockquote class="yoode-testimonial-text">
                "{{ block.settings.quote }}"
              </blockquote>

              <div class="yoode-testimonial-author">
                <div class="yoode-author-avatar">
                  {% if block.settings.author_image %}
                    {{ block.settings.author_image | image_url: width: 112 | image_tag: alt: block.settings.author_name, class: "yoode-author-image" }}
                  {% endif %}
                </div>
                <div class="yoode-author-info">
                  {% if block.settings.author_name != blank %}
                    <h3 class="yoode-author-name">{{ block.settings.author_name }}</h3>
                  {% endif %}
                  {% if block.settings.author_role != blank %}
                    <p class="yoode-author-role">{{ block.settings.author_role }}</p>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

