{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div class="rich-text rich-text--align-{{ section.settings.alignment }}{% if section.settings.full_width %}  rich-text--full-width color-{{ section.settings.color_scheme }} background{% else %} yoode-container{% endif %} collection-section-padding section-padding">
  <div class="rich-text__blocks section-{{ section.id }}-padding{% if section.settings.full_width %} yoode-container{% else %} color-{{ section.settings.color_scheme }} background{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <div
            class="rich-text__subheading subtitle"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.subheading | escape }}
          </div>
        {%- when 'heading' -%}
          {% assign heading_tag = block.settings.heading_tag %}

          <{{ heading_tag }}
            class="rich-text__heading title--section {{ block.settings.heading_size }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.heading }}
          </{{ heading_tag }}>
        {%- when 'text' -%}
          <div class="rich-text__text rte {% if settings.rte_type == 'custom' %} rte__container{% endif %}" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
        {%- when 'button' -%}
          {%- if block.settings.button_label != blank or block.settings.button_arrow -%}
            <a
              {% if block.settings.button_link == blank %}
                aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link }}"
              {% endif %}
              class="button button--{{ block.settings.button_style }} focus-inset"
              {% if settings.links_blank and block.settings.button_link.type == 'external_link' %}
                target="_blank"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="button__content">
                {% if block.settings.button_label != blank %}
                  <span class="button__label" data-label="{{ block.settings.button_label | escape }}">
                    {{- block.settings.button_label | escape -}}
                  </span>
                {% endif %}
                {% if block.settings.button_arrow %}
                  <div class="button__icons">
                    <span class="button__icon">
                      {% render 'icon-button-arrow' %}
                    </span>
                    <span class="button__icon button__icon--2">
                      {% render 'icon-button-arrow' %}
                    </span>
                  </div>
                {% endif %}
              </div>
              <span class="animated-button-circle"></span>
            </a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "spaced-section",
  "enabled_on": {
    "templates": ["*"]
