{{ 'yd-brand-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}

  .yd-brand-story-{{ section.id }} {
    --yd-bs-tagline-size: {{ section.settings.tagline_size }}px;
    --yd-bs-intro-size: {{ section.settings.intro_size }}px;
    --yd-bs-text-align: {{ section.settings.text_alignment }};
    --yd-bs-highlight-color: {{ section.settings.highlight_color }};
    --yd-bs-card-bg: {{ section.settings.card_background }};
    --yd-bs-card-border: {{ section.settings.card_border_color }};
    --yd-bs-card-radius: {{ section.settings.card_radius }}px;
    --yd-bs-card-padding: {{ section.settings.card_padding }}px;
    --yd-bs-card-title-size: {{ section.settings.card_title_size }}px;
    --yd-bs-card-text-size: {{ section.settings.card_text_size }}px;
    --yd-bs-icon-size: {{ section.settings.icon_size }}px;
    --yd-bs-icon-bg: {{ section.settings.icon_background }};
    --yd-bs-icon-color: {{ section.settings.icon_color }};
    --yd-bs-grid-gap: {{ section.settings.grid_gap }}px;
    --yd-bs-locations-bg: {{ section.settings.locations_background }};
    --yd-bs-locations-padding: {{ section.settings.locations_padding }}px;
    --yd-bs-locations-title-size: {{ section.settings.locations_title_size }}px;
    --yd-bs-location-text-size: {{ section.settings.location_text_size }}px;
    --yd-bs-location-item-bg: {{ section.settings.location_item_background }};
    --yd-bs-stat-number-size: {{ section.settings.stat_number_size }}px;
    --yd-bs-stat-label-size: {{ section.settings.stat_label_size }}px;
  }
{%- endstyle -%}

{%- liquid
  assign feature_cards = section.blocks | where: 'type', 'feature_card'
  assign location_items = section.blocks | where: 'type', 'location'
  assign stat_items = section.blocks | where: 'type', 'stat'
-%}

<div
  class="yd-brand-story yd-brand-story-{{ section.id }} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding section-padding"
  {{ section.shopify_attributes }}
>
  <div class="yd-brand-story__container">
    {%- comment -%} Header / Tagline {%- endcomment -%}
    <div class="yd-brand-story__header">
      <h2 class="yd-brand-story__tagline">
        <span>{{ section.settings.tagline_line_1 }}</span>
        <span class="yd-brand-story__highlight">{{ section.settings.tagline_line_2 }}</span>
        <span>{{ section.settings.tagline_line_3 }}</span>
      </h2>

      {% if section.settings.intro_text != blank %}
        <div class="yd-brand-story__intro rte">
          {{ section.settings.intro_text }}
        </div>
      {% endif %}
    </div>

    {%- comment -%} Feature Cards (blocks) {%- endcomment -%}
    {% if feature_cards.size > 0 %}
      <div class="yd-brand-story__grid">
        {% for block in feature_cards %}
          <div class="yd-brand-story__card" {{ block.shopify_attributes }}>
            <div class="yd-brand-story__card-icon">
              {% if block.settings.custom_icon != blank %}
                <img
                  src="{{ block.settings.custom_icon | image_url: width: 120 }}"
                  alt="{{ block.settings.title | escape }}"
                  width="{{ section.settings.icon_size | times: 0.5 | round }}"
                  height="{{ section.settings.icon_size | times: 0.5 | round }}"
                  loading="lazy"
                  class="yd-brand-story__card-icon-img"
                >
              {% else %}
                {% case block.settings.icon %}
                  {% when 'shield' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5zm0 18c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm-1-9h2v2h-2v-2zm0 4h2v2h-2v-2z"/>
                    </svg>
                  {% when 'document' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
                    </svg>
                  {% when 'checkmark' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                  {% when 'star' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% when 'heart' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                  {% when 'globe' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                    </svg>
                  {% when 'factory' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M22 10V6c0-1.11-.9-2-2-2h-6l-2-2H6C4.9 2 4 2.9 4 4v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-6l-2 2v4H6V4h5.17l2 2H20v4l2-2v2zm-2 6H6V4h5.17"/><path d="M2 6H0v16c0 1.1.9 2 2 2h16v-2H2V6z"/>
                    </svg>
                  {% when 'truck' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                    </svg>
                  {% when 'people' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                    </svg>
                  {% when 'lightning' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M7 2v11h3v9l7-12h-4l4-8z"/>
                    </svg>
                  {% when 'settings' %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                    </svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5zm0 18c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm-1-9h2v2h-2v-2zm0 4h2v2h-2v-2z"/>
                    </svg>
                {% endcase %}
              {% endif %}
            </div>
            <h3 class="yd-brand-story__card-title">{{ block.settings.title }}</h3>
            <p class="yd-brand-story__card-text">{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {%- comment -%} Locations {%- endcomment -%}
    {% if section.settings.show_locations and location_items.size > 0 %}
      <div class="yd-brand-story__locations">
        <h3 class="yd-brand-story__locations-title">{{ section.settings.locations_title }}</h3>
        <ul class="yd-brand-story__locations-list">
          {% for block in location_items %}
            {% if block.settings.name != blank %}
              <li class="yd-brand-story__location-item" {{ block.shopify_attributes }}>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                {{ block.settings.name }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {%- comment -%} Statistics {%- endcomment -%}
    {% if section.settings.show_stats and stat_items.size > 0 %}
      <div class="yd-brand-story__stats">
        {% for block in stat_items %}
          {% if block.settings.number != blank %}
            <div class="yd-brand-story__stat" {{ block.shopify_attributes }}>
              <div class="yd-brand-story__stat-number">{{ block.settings.number }}</div>
              <p class="yd-brand-story__stat-label">{{ block.settings.label }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "YD Brand Story",
  "class": "yd-brand-story-section spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Tagline"
    },
    {
      "type": "text",
      "id": "tagline_line_1",
      "label": "Tagline line 1",
      "default": "Built for Brands."
    },
    {
      "type": "text",
      "id": "tagline_line_2",
      "label": "Tagline line 2 (highlighted)",
      "default": "Powered by Manufacturing."
    },
    {
      "type": "text",
      "id": "tagline_line_3",
      "label": "Tagline line 3",
      "default": "Designed for Impact."
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Introduction text",
      "default": "<p>Yoode is an Indian fashion and custom merchandise brand redefining how organisations experience apparel. From fashion-forward athleisure to fully customised corporate merchandise, we bring together creativity, advanced technology, and strong manufacturing expertise under one roof.</p>"
    },
    {
      "type": "header",
      "content": "Locations"
    },
    {
      "type": "checkbox",
      "id": "show_locations",
      "label": "Show locations",
      "default": true
    },
    {
      "type": "text",
      "id": "locations_title",
      "label": "Locations title",
      "default": "Experience Stores"
    },
    {
      "type": "header",
      "content": "Statistics"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show statistics",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "tagline_size",
      "label": "Tagline size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "intro_size",
      "label": "Intro text size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 16,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "Card text size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "locations_title_size",
      "label": "Locations title size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "location_text_size",
      "label": "Location text size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "stat_number_size",
      "label": "Stat number size",
      "min": 32,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "stat_label_size",
      "label": "Stat label size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 15,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 40,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "locations_padding",
      "label": "Locations padding",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#000f9f"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#dee0e0"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#f2f1ef"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#262d33"
    },
    {
      "type": "color",
      "id": "locations_background",
      "label": "Locations background",
      "default": "#f2f1ef"
    },
    {
      "type": "color",
      "id": "location_item_background",
      "label": "Location item background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "Extra Small" },
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra Large" }
      ],
      "default": "xl",
      "label": "Padding top"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "Extra Small" },
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra Large" }
      ],
      "default": "xl",
      "label": "Padding bottom"
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "Extra Small" },
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra Large" }
      ],
      "default": "no-indent",
      "label": "Margin top"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "Extra Small" },
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra Large" }
      ],
      "default": "no-indent",
      "label": "Margin bottom"
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image",
          "info": "Upload a custom icon. If set, this overrides the icon select below."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Default icon (fallback)",
          "info": "Used when no custom icon image is uploaded.",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "document", "label": "Document" },
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "globe", "label": "Globe" },
            { "value": "factory", "label": "Factory" },
            { "value": "truck", "label": "Truck" },
            { "value": "people", "label": "People" },
            { "value": "lightning", "label": "Lightning" },
            { "value": "settings", "label": "Settings" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Feature description goes here."
        }
      ]
    },
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Location name",
          "default": "City Name"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "100"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Stat label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YD Brand Story",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "icon": "shield",
            "title": "Experience Stores",
            "text": "Get closer to your products with hands-on exploration of fabrics, finishes, fits, and final detailing. Make confident, informed decisions without guesswork."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "icon": "document",
            "title": "Manufacturing Excellence",
            "text": "Our headquarters in Tirupur ensures precision, consistency, and complete quality control at every stage. Built to scale efficiently while maintaining high standards."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "icon": "checkmark",
            "title": "Production Capacity",
            "text": "With capacity to produce 1,000 units per day, Yoode delivers at scale without compromising on quality in every piece we create."
          }
