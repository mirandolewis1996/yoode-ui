{{ 'yd-category-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .yd-category-card-{{ section.id }} {
    /* Section Colors */
    --bg-color: {{ section.settings.background_color | default: 'transparent' }};
    --title-color: {{ section.settings.heading_color }};
    --desc-color: {{ section.settings.description_color }};

    /* Card Colors */
    --card-bg-color: {{ section.settings.card_background }};
    --card-title-color: {{ section.settings.card_heading_color }};
    --card-desc-color: {{ section.settings.card_text_color }};

    --card-radius: {{ section.settings.card_radius }}px;
    --grid-gap: {{ section.settings.grid_gap }}px;
    --grid-cols-desktop: {{ section.settings.columns_desktop }};
    --grid-cols-mobile: {{ section.settings.columns_mobile }};
  }

  /* --- FIX: Styles for when the card becomes a link --- */
  .yd-category-card-{{ section.id }} .signature-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--card-radius);
    overflow: hidden;
    transition: transform 0.3s ease;
    
    /* Ensure the link version looks like a normal card */
    text-decoration: none;
    color: inherit;
    cursor: default; /* Default cursor if no link */
  }

  /* Specific styles for when it IS a link */
  .yd-category-card-{{ section.id }} a.signature-card {
    cursor: pointer;
  }

  .yd-category-card-{{ section.id }} .signature-card:hover {
    transform: translateY(-5px);
  }

  .yd-category-card-{{ section.id }} .card-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block; /* Removes bottom gap on images */
  }
{%- endstyle -%}

<div class="container section-padding">
  <div class="yd-category-card yd-category-card-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="title-section" style="text-align: {{ section.settings.header_alignment }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="title {{ section.settings.heading_size }}" style="color: var(--title-color);">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="description rte" style="color: var(--desc-color);">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="signature-cards">
      {%- for block in section.blocks -%}
        {%- liquid 
           # Logic to determine if we use an <a> tag or a <div> tag
           assign card_tag = 'div'
           if block.settings.link != blank
             assign card_tag = 'a'
           endif
        -%}

        <{{ card_tag }}
          class="signature-card color-{{ section.settings.card_color_scheme }} gradient"
          {% if block.settings.link != blank %} href="{{ block.settings.link }}" {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <img
              class="card-image"
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          <div class="card-content">
            {%- if block.settings.title != blank -%}
              <h3 class="title" style="color: var(--card-title-color);">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank and block.settings.text != '<p></p>' -%}
              <div class="para rte" style="color: var(--card-desc-color);">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
          
        </{{ card_tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YD Category Card",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Signature Products"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text_alignment",
      "id": "header_alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Number of columns on desktop",
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Number of columns on mobile",
      "default": 1
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section Color Scheme",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Custom Background Color",
      "info": "Overrides color scheme background if set."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#808080"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card Color Scheme",
      "default": "background-2"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Custom Card Background"
    },
    {
      "type": "color",
      "id": "card_heading_color",
      "label": "Card Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#808080"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "signature_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Product Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Description of the product.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YD Category Card",
      "blocks": [
        {
          "type": "signature_card",
          "settings": {
            "title": "Gift Boxes",
            "text": "<p>Luxurious packing, fine presentations, and exclusive high-class packaging.</p>"
          }
        },
        {
          "type": "signature_card",
          "settings": {
            "title": "Drinkware",
            "text": "<p>Stylish, personalized mugs, bottles, and flasks for everyday use.</p>"
          }
        },
        {
          "type": "signature_card",
          "settings": {
            "title": "Apparel",
            "text": "<p>High-quality, customizable workwear, t-shirts, and corporate uniforms.</p>"
          }
        },
        {
          "type": "signature_card",
          "settings": {
            "title": "Accessories",
            "text": "<p>Branded essentials, including notebooks, pens, bags, and keychains.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}