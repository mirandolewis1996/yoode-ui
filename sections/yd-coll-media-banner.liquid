{% style %}
  {% render 'section-margin' %}

  /* --- Desktop (Default) Styles --- */
  #Banner-{{ section.id }} {
    position: relative;
    overflow: hidden;
    {% if section.settings.desktop_height_unit == 'vh' %}
      height: {{ section.settings.banner_height_vh }}vh;
    {% else %}
      height: {{ section.settings.banner_height }}px;
    {% endif %}
  }

  #Banner-{{ section.id }} .banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
  }

  #Banner-{{ section.id }} .banner__image.img-desktop { display: block; }
  #Banner-{{ section.id }} .banner__image.img-ipad { display: none; }
  #Banner-{{ section.id }} .banner__image.img-mobile { display: none; }


  #Banner-{{ section.id }} .banner__content {
    justify-content: {{ section.settings.vertical_position }};
    align-items: {{ section.settings.horizontal_position }};
    height: 100%;
    display: flex;
    position: relative;
    z-index: 1;
  }

  #Banner-{{ section.id }} .banner__content-container {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.horizontal_position_button }};
  }

  #Banner-{{ section.id }} .banner__heading {
    font-size: 80px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    font-family: {{ section.settings.font_family }}, sans-serif;
    margin: 0 0 20px;
    line-height: 1.2;
  }

  #Banner-{{ section.id }} .banner__button {
    border: 1px solid {{ section.settings.button_color }};
    color: {{ section.settings.button_color }};
    padding: 10px 20px;
    text-decoration: none;
    transition: 0.3s;
  }

  #Banner-{{ section.id }} .banner__button:hover {
    background-color: {{ section.settings.text_color }};
    color: {% if section.settings.text_color == '#ffffff' %}#000000{% else %}#ffffff{% endif %};
  }

  #Banner-{{ section.id }} .banner__overlay {
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* --- iPad / Tablet Styles (Max 1024px) --- */
  @media screen and (max-width: 1024px) {
    #Banner-{{ section.id }} {
      {% if section.settings.ipad_height_unit == 'vh' %}
        height: {{ section.settings.banner_height_ipad_vh }}vh;
      {% else %}
        height: {{ section.settings.banner_height_ipad }}px;
      {% endif %}
    }
    #Banner-{{ section.id }} .banner__image.img-desktop { display: none; }
    #Banner-{{ section.id }} .banner__image.img-ipad { display: block; }
    #Banner-{{ section.id }} .banner__image.img-mobile { display: none; }
  }

  /* --- Mobile Styles (Max 767px) --- */
  @media screen and (max-width: 767px) {
    #Banner-{{ section.id }} {
      {% if section.settings.mobile_height_unit == 'vh' %}
        height: {{ section.settings.banner_height_mobile_vh }}vh;
      {% else %}
        height: {{ section.settings.banner_height_mobile }}px;
      {% endif %}
    }
    #Banner-{{ section.id }} .banner__heading {
        font-size: {{ section.settings.mobile_heading_size }}px;
    }
    #Banner-{{ section.id }} .banner__image.img-desktop { display: none; }
    #Banner-{{ section.id }} .banner__image.img-ipad { display: none; }
    #Banner-{{ section.id }} .banner__image.img-mobile { display: block; }

    #Banner-{{ section.id }} .banner__content .banner__content-container {
      align-items: center;
    }
  }

  /* --- Small Mobile Styles (Max 412px) --- */
  @media screen and (max-width: 412px) {
    #Banner-{{ section.id }} .banner__heading {
        font-size: {{ section.settings.small_mobile_heading_size }}px;
    }
  }
{% endstyle %}

<div id="Banner-{{ section.id }}" class="banner yd-coll-media-banner yd-title-size section-padding">
  {%- liquid
    assign desktop_img = section.settings.banner_image

    if section.settings.banner_image_ipad != blank
      assign ipad_img = section.settings.banner_image_ipad
    else
      assign ipad_img = desktop_img
    endif

    if section.settings.banner_image_mobile != blank
      assign mobile_img = section.settings.banner_image_mobile
    else
      assign mobile_img = ipad_img
    endif
  -%}

  {%- # 1. Desktop Image -%}
  {% if desktop_img %}
    {{
      desktop_img
      | image_url: width: 2000
      | image_tag: loading: 'lazy', class: 'banner__image img-desktop', alt: section.settings.heading
      | escape
    }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__image img-desktop placeholder' }}
  {% endif %}

  {%- # 2. iPad Image -%}
  {% if ipad_img %}
    {{
      ipad_img
      | image_url: width: 1400
      | image_tag: loading: 'lazy', class: 'banner__image img-ipad', alt: section.settings.heading
      | escape
    }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__image img-ipad placeholder' }}
  {% endif %}

  {%- # 3. Mobile Image -%}
  {% if mobile_img %}
    {{
      mobile_img
      | image_url: width: 800
      | image_tag: loading: 'lazy', class: 'banner__image img-mobile', alt: section.settings.heading
      | escape
    }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__image img-mobile placeholder' }}
  {% endif %}

  <div class="banner__overlay"></div>

  <div class="banner__content">
    <div class="banner__content-container">
      {% if section.settings.heading != blank %}
        <h2 class="banner__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.button_text != blank %}
        {% render 'button',
          btn_link: section.settings.button_link,
          btn_label: section.settings.button_text,
          btn_style: section.settings.button_style,
          btn_arrow: section.settings.button_arrow,
          yd_global: section.settings.use_yd_global_button
        %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
