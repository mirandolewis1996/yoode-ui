{% schema %}
{
  "name": "YD Polo Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Custom T-Shirt Printing for Every Occasion"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlight Word",
      "default": "T-Shirt"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Text Color",
      "default": "#f05a28"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "Color Scheme"
    }
  ],
  "blocks": [
    {
      "type": "polo_item",
      "name": "Polo Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image Fit",
          "options": [
            { "value": "cover", "label": "Cover" },
            { "value": "contain", "label": "Contain" }
          ],
          "default": "cover"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image Position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Polo Title" },
        {
          "type": "select",
          "id": "title_weight",
          "label": "Title Weight",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "600", "label": "Semi Bold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "600"
        },
        { "type": "textarea", "id": "description", "label": "Description" },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    { "name": "YD Polo Showcase", "category": "Custom" }
  ]
}
{% endschema %}

<div class="polo-showcase color-{{ section.settings.color_scheme }} section-padding">
  <div class="container">

    <!-- Heading -->
<h2 class="polo-showcase-h2">
  {% if section.settings.highlight_word != blank %}

    {% assign highlight = section.settings.highlight_word %}
    {% assign parts = section.settings.heading | split: highlight %}

    {{ parts[0] }}
    <span style="color: {{ section.settings.highlight_color }}">
      {{ highlight }}
    </span>
    {{ parts[1] }}

  {% else %}

    {{ section.settings.heading }}

  {% endif %}
</h2>

    <!-- Items -->
    <div class="polo-list">
      {% for block in section.blocks %}
        <div class="polo-item {% if block.settings.image_position == 'right' %}reverse{% endif %}">

          <!-- Image -->
          <div class="polo-image">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.title }}"
                loading="lazy"
                style="object-fit: {{ block.settings.image_fit }};"
              >
            {% endif %}
          </div>

          <!-- Content -->
          <div class="polo-content" style="text-align: {{ block.settings.text_align }}">
            <h3 style="font-weight: {{ block.settings.title_weight }}">
              {{ block.settings.title }}
            </h3>
            <p>{{ block.settings.description }}</p>
          </div>

        </div>
      {% endfor %}
    </div>

  </div>
</div>

<style>
.polo-showcase {
  padding: 60px 20px;
}

.container {
  max-width: 1100px;
  margin: auto;
}

/* Heading */
.polo-showcase-h2 {
  text-align:center;
  margin-bottom: 50px;
}

/* List */
.polo-list {
  display: flex;
  flex-direction: column;
  gap: 50px;
}

/* Item */
.polo-item {
  display: flex;
  align-items: center;
  gap: 40px;
}

.polo-item.reverse {
  flex-direction: row-reverse;
}

/* Image */
.polo-image {
  flex: 0 0 40%;
  aspect-ratio: 4 / 3; 
  overflow: hidden;
  border-radius: 16px;
}

.polo-image img {
  width: 100%;
  height: 100%;
  display: block;
}

/* Content */
.polo-content {
  flex: 1;
}

.polo-content h3 {
  font-size: 22px;
  margin-bottom: 10px;
}

.polo-content p {
  font-size: 15px;
  line-height: 1.6;
  color: rgba(0,0,0,0.7);
}

/* 📱 Mobile */
@media (max-width: 768px) {
  .polo-item {
    flex-direction: column !important;
    text-align: center;
  }

  .polo-image {
    width: 100%;
    aspect-ratio: 16 / 9;
  }
}
</style>