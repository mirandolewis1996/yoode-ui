  <script>
    const testimonials = [
      {
        quote:
          'Yoode delivered our startup’s first merchandise collection, and the quality exceeded expectations. The fabric and print finish were premium.',
        author: 'Founder, D2C Apparel Brand',
      },
      {
        quote: 'The print-on-demand process was smooth from start to finish. The print quality, fabric feel, and color accuracy were exactly what we wanted. Orders were delivered on time, and the team handled our custom requirements professionally.',
        author: 'FOUNDER, CLOTHING BRAND',
      },
      {
        quote: 'We ordered custom t-shirts for our brand launch, and the results were impressive. The prints were sharp, the material felt premium, and there was no minimum order requirement. Perfect solution for startups and small batches.',
        author: 'MARKETING MANAGER, STARTUP BRAND',
      },
    ];

    let current = 0;

    const quoteEl = document.querySelector('.testimonial-quote p');
    const authorEl = document.querySelector('.subtitle.rating p');
    const nextBtn = document.querySelector('.next-btn');
    const prevBtn = document.querySelector('.prev-btn');

    function updateTestimonial(index) {
      gsap.to([quoteEl, authorEl], {
        opacity: 0,
        y: 20,
        duration: 0.3,
        onComplete: () => {
          quoteEl.textContent = testimonials[index].quote;
          authorEl.textContent = testimonials[index].author;

          gsap.fromTo([quoteEl, authorEl], { opacity: 0, y: -20 }, { opacity: 1, y: 0, duration: 0.4 });
        },
      });
    }

    nextBtn.addEventListener('click', () => {
      current++;
      if (current >= testimonials.length) current = 0;
      updateTestimonial(current);
    });

    prevBtn.addEventListener('click', () => {
      current--;
      if (current < 0) current = testimonials.length - 1;
      updateTestimonial(current);
    });

    // Auto slide
    setInterval(() => {
      current++;
      if (current >= testimonials.length) current = 0;
      updateTestimonial(current);
    }, 5000);
  </script>

