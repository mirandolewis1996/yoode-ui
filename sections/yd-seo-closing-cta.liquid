<section
  class="yd-seo-section yd-seo-cta"
  aria-labelledby="yd-seo-cta-title-{{ section.id }}"
  style="
    --yd-seo-dark:{{ section.settings.bg_colour }};
    --yd-seo-cta-min-h:{{ section.settings.min_height }}px;
    --yd-seo-orb-float:{{ section.settings.orb_float }}rem;
    --yd-seo-orb-cycle:{{ section.settings.orb_cycle }}s;
  "
>
  {%- if section.blocks.size > 0 -%}
    <div class="yd-seo-cta-orbs" aria-hidden="true">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <span
            class="yd-seo-orb{% if block.settings.inner %} yd-seo-orb-inner{% endif %}"
            style="
              --yd-seo-orb-x:{{ block.settings.pos_x }}%;
              --yd-seo-orb-y:{{ block.settings.pos_y }}%;
              --yd-seo-orb-size:var(--yd-seo-orb-{{ block.settings.size }});
              --yd-seo-i:{{ forloop.index0 }}
            "
            {{ block.shopify_attributes }}
          >
            <img
              class="yd-seo-orb-img"
              src="{{ block.settings.image | image_url: width: 300 }}"
              alt="{{ block.settings.image_alt | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              decoding="async"
            >
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="yd-seo-container">
    {%- if section.blocks.size == 0 and request.design_mode -%}
      <p class="yd-seo-editor-hint">{{ section.settings.empty_hint }}</p>
    {%- endif -%}
    <div class="yd-seo-head yd-seo-reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="yd-seo-title" id="yd-seo-cta-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="yd-seo-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="yd-seo-cta-action yd-seo-reveal" style="--yd-seo-i:1">
        <button
          class="yd-seo-btn yd-seo-btn-primary"
          id="yd-seo-modal-open-{{ section.id }}"
          aria-haspopup="dialog"
          aria-controls="yd-enquiry-modal"
          data-yd-enquiry-open
        >
          {{ section.settings.button_label }}
          <svg
            class="yd-seo-icon"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "YD SEO Closing CTA",
  "tag": "section",
  "class": "yd-seo-shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "empty_hint",
      "label": "Empty-state hint (theme editor only)",
      "default": "Add blocks to fill this section."
    },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready To Kit Your Team?" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Send your idea on WhatsApp and get a free mockup back. You only pay once the design is signed off."
    },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Get A Free Mockup" },
    { "type": "url", "id": "button_url", "label": "Button link" },

    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_colour", "label": "Background", "default": "#1e1e1e" },
    {
      "type": "range",
      "id": "min_height",
      "min": 160,
      "max": 480,
      "step": 10,
      "unit": "px",
      "label": "Minimum height",
      "default": 290
    },

    { "type": "header", "content": "Floating circles" },
    {
      "type": "range",
      "id": "orb_float",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "rem",
      "label": "Drift distance",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "orb_cycle",
      "min": 2,
      "max": 14,
      "step": 1,
      "unit": "s",
      "label": "Drift speed",
      "default": 6,
      "info": "Each circle is offset so they do not bob in unison. Motion is disabled for visitors who prefer reduced motion."
    }
  ],
  "blocks": [
    {
      "type": "orb",
      "name": "Floating circle",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "A circular cut-out with transparent corners works best."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Alt text",
          "info": "Leave empty if the circle is purely decorative."
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "default": "md",
          "options": [
            { "value": "md", "label": "Medium" },
            { "value": "lg", "label": "Large" }
          ]
        },
        {
          "type": "range",
          "id": "pos_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 10
        },
        {
          "type": "range",
          "id": "pos_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 35
        },
        {
          "type": "checkbox",
          "id": "inner",
          "label": "Hide earlier on small screens",
          "default": false,
          "info": "Turn on for circles that sit at headline height, so they drop out before the rest."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YD SEO Closing CTA",
      "blocks": [
        { "type": "orb", "settings": { "size": "lg", "pos_x": 8, "pos_y": 36, "inner": false } },
        { "type": "orb", "settings": { "size": "md", "pos_x": 22, "pos_y": 27, "inner": true } },
        { "type": "orb", "settings": { "size": "md", "pos_x": 17, "pos_y": 68, "inner": false } },
        { "type": "orb", "settings": { "size": "md", "pos_x": 75, "pos_y": 30, "inner": true } },
        { "type": "orb", "settings": { "size": "lg", "pos_x": 91, "pos_y": 36, "inner": false } },
        { "type": "orb", "settings": { "size": "md", "pos_x": 81, "pos_y": 69, "inner": false } }
      ]
    }
  ]
}
{% endschema %}
