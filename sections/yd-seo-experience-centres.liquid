<section class="yd-seo-section yd-seo-stores" aria-labelledby="yd-seo-stores-title-{{ section.id }}"
         style="--yd-seo-stores-cols:{{ section.settings.columns }};
                --yd-seo-cream:{{ section.settings.bg_colour }};
                --yd-seo-dark:{{ section.settings.card_colour }};
                --yd-seo-whatsapp:{{ section.settings.whatsapp_colour }};">
  <div class="yd-seo-container">
    {%- if section.blocks.size == 0 and request.design_mode -%}
      <p class="yd-seo-editor-hint">{{ section.settings.empty_hint }}</p>
    {%- endif -%}
    
    <div class="yd-seo-head yd-seo-reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="yd-seo-title" id="yd-seo-stores-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="yd-seo-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <ul class="yd-seo-store-grid">
      {%- for block in section.blocks -%}
        <li class="yd-seo-store yd-seo-reveal" style="--yd-seo-i:{{ forloop.index0 }}"
            {{ block.shopify_attributes }}>

          {%- if block.settings.image != blank -%}
            <img class="yd-seo-store-photo"
                 src="{{ block.settings.image | image_url: width: 800 }}"
                 srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                         {{ block.settings.image | image_url: width: 800 }} 800w"
                 sizes="(max-width: 767px) 92vw, 22vw"
                 alt="{{ block.settings.image_alt | escape }}"
                 title="{{ block.settings.front_image_title | escape }}"
                 width="{{ block.settings.image.width }}"
                 height="{{ block.settings.image.height }}"
                 style="--yd-seo-store-photo-ratio:{{ block.settings.image.width }} / {{ block.settings.image.height }};"
                 loading="lazy" decoding="async">
          {%- endif -%}

          <div class="yd-seo-store-body">
            {%- if block.settings.city != blank -%}
              <h3 class="yd-seo-store-name">{{ block.settings.city }}</h3>
            {%- endif -%}
            {%- if block.settings.address != blank -%}
              <p class="yd-seo-store-address">{{ block.settings.address }}</p>
            {%- endif -%}

            <p class="yd-seo-store-hours">
              <svg class="yd-seo-icon-sm" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                   stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="8" cy="8" r="6.2"/><path d="M8 4.6V8l2.4 1.4"/>
              </svg>
              {{ block.settings.days }}
              <span class="yd-seo-store-sep" aria-hidden="true">|</span>
              {{ block.settings.hours }}
            </p>

            <div class="yd-seo-store-actions">
              {%- if block.settings.directions_label != blank -%}
                <a class="yd-seo-btn yd-seo-btn-sm yd-seo-btn-primary"
                   href="{{ block.settings.directions_url | default: '#' }}" target="_blank">
                  {{ block.settings.directions_label }}
                  <svg class="yd-seo-icon-sm" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                       stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"/>
                  </svg>
                </a>
              {%- endif -%}
              {%- if block.settings.whatsapp_label != blank -%}
                <a class="yd-seo-btn yd-seo-btn-sm yd-seo-btn-whatsapp" target="_blank"
                   href="https://wa.me/{{ block.settings.phnumber }}?text=Hi Yoode {{ block.settings.city }}! I’m interested in custom sports jerseys. Could you help me with designs, pricing and placing an order?">
                  <svg class="yd-seo-icon-sm" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.15 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29Z"/>
                  </svg>
                  {{ block.settings.whatsapp_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{% schema %}
{
  "name": "YD SEO Experience Centres",
  "tag": "section",
  "class": "yd-seo-shopify-section",
  "settings": [
    { "type": "text", "id": "empty_hint", "label": "Empty-state hint (theme editor only)",
      "default": "Add blocks to fill this section." },
    { "type": "header", "content": "Heading" },
    { "type": "text",     "id": "heading",    "label": "Heading", "default": "Visit A Yoode Experience Centre" },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Walk in to feel the fabrics, check the print quality and design your kit with the team. Open Mon–Sat, 10am to 8pm." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "min": 1, "max": 5, "step": 1,
      "label": "Columns (desktop)", "default": 4 },
    { "type": "color", "id": "bg_colour",       "label": "Background",      "default": "#fdf0e4" },
    { "type": "color", "id": "card_colour",     "label": "Card background", "default": "#1e1e1e" },
    { "type": "color", "id": "whatsapp_colour", "label": "WhatsApp button colour", "default": "#25d366" }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Store photo" },
        {"type": "text", "id": "front_image_title", "label": "Front Image Title", "default": "Front View"},
        { "type": "text",     "id": "image_alt", "label": "Photo alt text" },
        { "type": "text",     "id": "city",    "label": "City", "default": "Bangalore" },
        { "type": "text",     "id": "phnumber",    "label": "Whatsapp Number", "default": "+918069750293" },
        { "type": "textarea", "id": "address", "label": "Address",
          "default": "Ground Floor #68, Transpade Tower, Jyoti Nivas College Road, Koramangala Industrial Layout, 5th Block, Koramangala, Bengaluru 560095" },
        { "type": "text", "id": "days",  "label": "Open days",  "default": "Mon - Sat" },
        { "type": "text", "id": "hours", "label": "Open hours", "default": "10AM - 8PM" },
        { "type": "header", "content": "Buttons" },
        { "type": "text", "id": "directions_label", "label": "Directions button text", "default": "Get Directions" },
        { "type": "url",  "id": "directions_url",   "label": "Directions link", "info": "Paste the Google Maps link." },
        { "type": "text", "id": "whatsapp_label",   "label": "WhatsApp button text", "default": "Whatsapp" },
        { "type": "url",  "id": "whatsapp_url",     "label": "WhatsApp link",
          "info": "Use a wa.me link, for example https://wa.me/919000000000" }
      ]
    }
  ],
  "presets": [
    {
      "name": "YD SEO Experience Centres",
      "blocks": [
        { "type": "store", "settings": { "city": "Bangalore","phnumber":"+918069750293",
          "address": "Ground Floor #68, Transpade Tower, Jyoti Nivas College Road, Koramangala Industrial Layout, 5th Block, Koramangala, Bengaluru 560095" } },
        { "type": "store", "settings": { "city": "Chennai","phnumber":"+918069750293",
          "address": "First Floor, City Centre Complex, No.6, 66/39, Thirumalai Pillai Road, T. Nagar, Chennai, Tamil Nadu 600017" } },
        { "type": "store", "settings": { "city": "Trivandrum","phnumber":"+918069750293",
          "address": "Ground Floor, CloudQ Towers, 223/18-1, Service Road, near Technopark Campus, Phase 1, Kazhakkoottam, Thiruvananthapuram, Kerala 695582" } },
        { "type": "store", "settings": { "city": "Marthandam","phnumber":"+918069750293",
          "address": "Eraviputhoorkadai, 1st Floor, Adhesh Tower, near AB.AB & CO, Marthandam, Tamil Nadu 629155" } }
      ]
    }
  ]
}
{% endschema %}