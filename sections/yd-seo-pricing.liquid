<section class="yd-seo-section yd-seo-pricing" aria-labelledby="yd-seo-pricing-title-{{ section.id }}"
         style="--yd-seo-price-cols:{{ section.settings.columns }};
                --yd-seo-dark:{{ section.settings.card_colour }};
                --yd-seo-primary:{{ section.settings.accent_colour }};">
  <div class="yd-seo-container">
    {%- if section.blocks.size == 0 and request.design_mode -%}
      <p class="yd-seo-editor-hint">{{ section.settings.empty_hint }}</p>
    {%- endif -%}
    
    <div class="yd-seo-pricing-intro">
      <div class="yd-seo-pricing-lead yd-seo-reveal">
        {%- if section.settings.badge != blank -%}
          <span class="yd-seo-badge">{{ section.settings.badge }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="yd-seo-title" id="yd-seo-pricing-title-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      <div class="yd-seo-pricing-aside yd-seo-reveal" style="--yd-seo-i:1">
        {%- if section.settings.text != blank -%}
          <p class="yd-seo-text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <button class="yd-seo-btn yd-seo-btn-primary" type="button"
          class="yd-seo-btn yd-seo-btn-primary"
          id="yd-seo-modal-open-{{ section.id }}"
          aria-haspopup="dialog"
          aria-controls="yd-enquiry-modal"
          data-yd-enquiry-open >
            {{ section.settings.button_label }}
            <svg class="yd-seo-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6"/>
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>

    <ul class="yd-seo-price-grid">
      {%- for block in section.blocks -%}
        <li class="yd-seo-price-item yd-seo-reveal" style="--yd-seo-i:{{ forloop.index0 }}"
            {{ block.shopify_attributes }}>
          <a class="yd-seo-price-card">
            <figure class="yd-seo-price-figure"
                    {% if block.settings.image != blank %}style="--yd-seo-price-img-ratio:{{ block.settings.image.width }} / {{ block.settings.image.height }};"{% endif %}>
              {%- if block.settings.image != blank -%}
                <img class="yd-seo-price-img"
                     src="{{ block.settings.image | image_url: width: 600 }}"
                     srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                             {{ block.settings.image | image_url: width: 600 }} 600w"
                     sizes="(max-width: 767px) 45vw, 20vw"
                     title="{{ block.settings.front_image_title | escape }}"
                     alt="{{ block.settings.image_alt | escape }}"
                     width="{{ block.settings.image.width }}"
                     height="{{ block.settings.image.height }}"
                     loading="lazy" decoding="async">
              {%- endif -%}
            </figure>
            <div class="yd-seo-price-body">
              {%- if block.settings.title != blank -%}
                <h3 class="yd-seo-price-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <p class="yd-seo-price-note">{{ block.settings.note }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{% schema %}
{
  "name": "YD SEO Pricing",
  "tag": "section",
  "class": "yd-seo-shopify-section",
  "settings": [
    { "type": "text", "id": "empty_hint", "label": "Empty-state hint (theme editor only)",
      "default": "Add blocks to fill this section." },
    { "type": "header", "content": "Intro" },
    { "type": "text",     "id": "badge",   "label": "Badge",   "default": "Transparent pricing" },
    { "type": "text",     "id": "heading", "label": "Heading", "default": "Jerseys from Rs.460, names and numbers included." },
    { "type": "textarea", "id": "text",    "label": "Description",
      "default": "The final quote depends on fabric, sleeve length, print coverage and quantity. The bigger the squad, the lower the per-piece price — and the mockup is always free." },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Get My Quote" },
    { "type": "url",  "id": "button_url",   "label": "Button link" },

    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1,
      "label": "Cards per row (desktop)", "default": 5 },
    { "type": "color", "id": "card_colour",   "label": "Card background", "default": "#1e1e1e" },
    { "type": "color", "id": "accent_colour", "label": "Price colour",    "default": "#f05a22" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Price card",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {"type": "text", "id": "front_image_title", "label": "Front Image Title", "default": "Front View"},
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "title", "label": "Title", "default": "Junior Jersey" },
        { "type": "text", "id": "note",  "label": "Price note", "default": "Starts from Rs.460" },
        { "type": "url",  "id": "url",   "label": "Card link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "YD SEO Pricing",
      "blocks": [
        { "type": "tier", "settings": { "title": "Junior Jersey",              "note": "Starts from Rs.460" } },
        { "type": "tier", "settings": { "title": "Adult Jersey",               "note": "Starts from Rs.650" } },
        { "type": "tier", "settings": { "title": "Full-Sleeve & Raglan Styles","note": "Starts from Rs.750" } },
        { "type": "tier", "settings": { "title": "Team Order (11+ Pieces)",    "note": "Lower per piece" } },
        { "type": "tier", "settings": { "title": "Design Mockup",              "note": "Free" } }
      ]
    }
  ]
}
{% endschema %}