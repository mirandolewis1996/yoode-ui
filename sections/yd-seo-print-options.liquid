{%- assign half = section.blocks.size | plus: 1 | divided_by: 2 -%}

<section
  class="yd-seo-section yd-seo-print"
  aria-labelledby="yd-seo-print-title-{{ section.id }}"
  style="
    --yd-seo-cream:{{ section.settings.bg_colour }};
    --yd-seo-print-min-h:{{ section.settings.min_height }}vh;
    --yd-seo-print-model-h:clamp(260px,34vw,{{ section.settings.model_height }}px);
  "
>
  <div class="yd-seo-container">
    {%- if section.blocks.size == 0 and request.design_mode -%}
      <p class="yd-seo-editor-hint">{{ section.settings.empty_hint }}</p>
    {%- endif -%}

    <div class="yd-seo-head yd-seo-reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="yd-seo-title" id="yd-seo-print-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="yd-seo-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="yd-seo-print-stage">
      <!-- Left column ------------------------------------------------- -->
      <ul class="yd-seo-print-list" role="list">
        {%- for block in section.blocks -%}
          {%- if forloop.index <= half -%}
            <li
              class="yd-seo-print-card yd-seo-reveal"
              style="--yd-seo-i:{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <figure class="yd-seo-print-figure">
                {%- if block.settings.image != blank -%}
                  <img
                    class="yd-seo-print-img"
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    title="{{ block.settings.front_image_title | escape }}"
                    alt="{{ block.settings.image_alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- endif -%}
              </figure>
              <div class="yd-seo-print-body">
                {%- if block.settings.title != blank -%}
                  <h3 class="yd-seo-print-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="yd-seo-print-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <!-- Kit views --------------------------------------------------- -->
      <div class="yd-seo-print-media yd-seo-reveal">
        {%- if section.settings.kit_front != blank -%}
          <img
            class="yd-seo-print-model"
            src="{{ section.settings.kit_front | image_url: width: 500 }}"
            title="{{ section.settings.front_image_title | escape }}"
            alt="{{ section.settings.kit_front_alt | escape }}"
            width="{{ section.settings.kit_front.width }}"
            height="{{ section.settings.kit_front.height }}"
            loading="lazy"
            decoding="async"
          >
        {%- endif -%}
        {%- if section.settings.kit_back != blank -%}
          <img
            class="yd-seo-print-model"
            src="{{ section.settings.kit_back | image_url: width: 500 }}"
            title="{{ section.settings.front_image_title | escape }}"
            alt="{{ section.settings.kit_back_alt | escape }}"
            width="{{ section.settings.kit_back.width }}"
            height="{{ section.settings.kit_back.height }}"
            loading="lazy"
            decoding="async"
          >
        {%- endif -%}
      </div>

      <!-- Right column ------------------------------------------------ -->
      <ul class="yd-seo-print-list" role="list">
        {%- for block in section.blocks -%}
          {%- if forloop.index > half -%}
            <li
              class="yd-seo-print-card yd-seo-reveal"
              style="--yd-seo-i:{{ forloop.index0 | minus: half }}"
              {{ block.shopify_attributes }}
            >
              <figure class="yd-seo-print-figure">
                {%- if block.settings.image != blank -%}
                  <img
                    class="yd-seo-print-img"
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    title="{{ block.settings.front_image_title | escape }}"
                    alt="{{ block.settings.image_alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- endif -%}
              </figure>
              <div class="yd-seo-print-body">
                {%- if block.settings.title != blank -%}
                  <h3 class="yd-seo-print-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="yd-seo-print-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "YD SEO Print Options",
  "tag": "section",
  "class": "yd-seo-shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "empty_hint",
      "label": "Empty-state hint (theme editor only)",
      "default": "Add blocks to fill this section."
    },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What You Can Put On The Jersey" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mix any of these on a single kit. Everything is printed into the fabric, so nothing peels or cracks in the wash."
    },

    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg_colour", "label": "Background", "default": "#fdf0e4" },
    {
      "type": "range",
      "id": "min_height",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum section height",
      "default": 100
    },

    { "type": "header", "content": "Kit views (centre)" },
    { "type": "image_picker", "id": "kit_front", "label": "Kit front image" },
    { "type": "text", "id": "front_image_title", "label": "Front Image Title", "default": "Front View" },

    {
      "type": "text",
      "id": "kit_front_alt",
      "label": "Front image alt text",
      "default": "Front view of a custom kit with crest and sponsor print"
    },
    { "type": "image_picker", "id": "kit_back", "label": "Kit back image" },
    {
      "type": "text",
      "id": "kit_back_alt",
      "label": "Back image alt text",
      "default": "Back view of the same kit showing the player name and number"
    },
    {
      "type": "range",
      "id": "model_height",
      "min": 260,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Maximum kit height",
      "default": 530
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Print option",
      "limit": 10,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Close-up image" },
        { "type": "text", "id": "front_image_title", "label": "Front Image Title", "default": "Front View" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "title", "label": "Title", "default": "Team Logo" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Your club or company crest on the chest, sleeve or back yoke, matched to your brand colours."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "YD SEO Print Options",
      "blocks": [
        {
          "type": "option",
          "settings": {
            "title": "Team Logo",
            "text": "Your club or company crest on the chest, sleeve or back yoke, matched to your brand colours."
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "Player Name",
            "text": "A different name on every jersey at no extra charge. Send us the list and we handle the rest."
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "Player Number",
            "text": "Front, back and shorts. Choose the numeral style, outline and size that suits your sport."
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "Sponsor Logos",
            "text": "Multiple sponsors placed cleanly across the front, sleeves and back without crowding your own crest."
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "Team Colours",
            "text": "Any shade you need, including exact brand codes, plus separate home and away sets."
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "Patterns & All-Over Prints",
            "text": "Gradients, geometrics and full-sublimation graphics that run edge to edge across the whole garment."
          }
        }
      ]
    }
  ]
}
{% endschema %}
