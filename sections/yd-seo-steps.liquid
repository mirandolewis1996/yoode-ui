<section class="yd-seo-section yd-seo-steps" aria-labelledby="yd-seo-steps-title-{{ section.id }}"
         data-step-speed="{{ section.settings.step_speed }}"
         style="--yd-seo-dark:{{ section.settings.bg_colour }};
                --yd-seo-primary:{{ section.settings.accent_colour }};
                --yd-seo-steps-media-w:clamp(192px,144px + 10vw,{{ section.settings.shot_width }}px);">
  <div class="yd-seo-container">

    <div class="yd-seo-head yd-seo-reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="yd-seo-title" id="yd-seo-steps-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="yd-seo-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="yd-seo-steps-layout">

      <ol class="yd-seo-step-list">
        {%- for block in section.blocks -%}
          <li class="yd-seo-step{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            <p class="yd-seo-step-num">{{ block.settings.number }}</p>
            {%- if block.settings.title != blank -%}
              <h3 class="yd-seo-step-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="yd-seo-step-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>

      {%- if section.settings.image != blank -%}
        <div class="yd-seo-steps-media yd-seo-reveal">
          <div class="yd-seo-steps-frame"
               style="--yd-seo-shot-ratio:{{ section.settings.image.width }} / {{ section.settings.image.height }};">
            {%- if section.settings.show_ring -%}
              {%- comment -%}
                The ring traces the artwork itself: a rounded rect the size of the
                card, tilted the other way and sitting behind it, so only its
                corners show past the edges. All four numbers are settings.
              {%- endcomment -%}
              <svg class="yd-seo-scribble" viewBox="0 0 427 479" fill="none" aria-hidden="true">
                <rect pathLength="1"
                      x="{{ section.settings.ring_inset }}"
                      y="{{ section.settings.ring_inset }}"
                      width="{{ 427 | minus: section.settings.ring_inset | minus: section.settings.ring_inset }}"
                      height="{{ 479 | minus: section.settings.ring_inset | minus: section.settings.ring_inset }}"
                      rx="{{ section.settings.ring_radius }}"
                      transform="rotate({{ section.settings.ring_tilt }} 213.5 239.5)"/>
              </svg>
            {%- endif -%}
            <img class="yd-seo-steps-shot"
                 src="{{ section.settings.image | image_url: width: 900 }}"
                 srcset="{{ section.settings.image | image_url: width: 450 }} 450w,
                         {{ section.settings.image | image_url: width: 900 }} 900w"
                 sizes="(max-width: 991px) 80vw, 20vw"
                 alt="{{ section.settings.image_alt | escape }}"
                 width="{{ section.settings.image.width }}"
                 height="{{ section.settings.image.height }}"
                 loading="lazy" decoding="async">
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "YD SEO Steps",
  "tag": "section",
  "class": "yd-seo-shopify-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text",     "id": "heading",    "label": "Heading", "default": "How To Create Your Custom Jersey" },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Four steps from an idea in a group chat to a kit in your team's hands." },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_colour",     "label": "Background",      "default": "#1e1e1e" },
    { "type": "color", "id": "accent_colour", "label": "Active step colour", "default": "#f05a22" },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Screenshot / photo" },
    { "type": "text", "id": "image_alt", "label": "Image alt text",
      "default": "The Yoode online store showing two custom jersey styles ready to personalise" },
    { "type": "range", "id": "shot_width", "min": 160, "max": 420, "step": 10, "unit": "px",
      "label": "Maximum image width", "default": 280 },

    { "type": "header", "content": "Hand-drawn ring" },
    { "type": "checkbox", "id": "show_ring", "label": "Show ring behind the image", "default": true },
    { "type": "range", "id": "ring_tilt",   "min": -20, "max": 20, "step": 1, "unit": "°",
      "label": "Ring tilt", "default": -7,
      "info": "Tilts the ring against the image so only its corners peek out." },
    { "type": "range", "id": "ring_inset",  "min": 0, "max": 60, "step": 2, "unit": "px",
      "label": "Ring inset", "default": 44 },
    { "type": "range", "id": "ring_radius", "min": 0, "max": 80, "step": 2, "unit": "px",
      "label": "Ring corner radius", "default": 30 },

    { "type": "header", "content": "Animation" },
    { "type": "range", "id": "step_speed", "min": 1500, "max": 8000, "step": 100, "unit": "ms",
      "label": "Time on each step", "default": 3200,
      "info": "The highlight walks the rows while the section is on screen, and follows the pointer on hover." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 8,
      "settings": [
        { "type": "text",     "id": "number", "label": "Number", "default": "01" },
        { "type": "text",     "id": "title",  "label": "Title",  "default": "Choose Your Style" },
        { "type": "textarea", "id": "text",   "label": "Description",
          "default": "Pick a neck and sleeve — polo, crew, V-neck, mandarin or raglan, half or full sleeve, adult or junior." }
      ]
    }
  ],
  "presets": [
    {
      "name": "YD SEO Steps",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "title": "Choose Your Style",    "text": "Pick a neck and sleeve — polo, crew, V-neck, mandarin or raglan, half or full sleeve, adult or junior." } },
        { "type": "step", "settings": { "number": "02", "title": "Send Your Design",     "text": "Share your artwork, logo and colours on WhatsApp. No design yet? Our team will draw one for you." } },
        { "type": "step", "settings": { "number": "03", "title": "Approve The Mockup",   "text": "We send a realistic mockup with names, numbers and sponsor placements. Changes are free until you're happy." } },
        { "type": "step", "settings": { "number": "04", "title": "Wear It On The Field", "text": "Printed, stitched and checked at our own unit, then delivered to you or collected from any Experience Centre." } }
      ]
    }
  ]
}
{% endschema %}