{{ 'yd-vertical-timeline.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .yd-vertical-timeline-{{ section.id }} {
    /* Color Scheme Fallback or Override */
    --bg-color: {{ section.settings.background_color | default: 'transparent' }};

    /* Timeline Colors */
    --line-color: {{ section.settings.line_color }};
    --dot-color: {{ section.settings.dot_color }};
    --dot-border-color: {{ section.settings.dot_border_color }};

    /* Text Colors */
    --title-color: {{ section.settings.title_color }};
    --subtitle-color: {{ section.settings.subtitle_color }};
    --date-color: {{ section.settings.date_color }};
    --desc-color: {{ section.settings.description_color }};
    --main-title-color: {{ section.settings.heading_color }};
    --main-subtitle-color: {{ section.settings.description_color_main }};

    /* Card Style */
    --card-bg: {{ section.settings.card_background }};
    --card-border-color: {{ section.settings.card_border_color }};

    /* Dimensions */
    --line-width: {{ section.settings.line_width }}px;
    --dot-size: {{ section.settings.dot_size }}px;
    --dot-border-width: {{ section.settings.dot_border_width }}px;
    --dot-top-offset: {{ section.settings.dot_top_offset }}px;
    --content-gap: {{ section.settings.content_gap }}px;
    --item-spacing: {{ section.settings.item_spacing }}px;
    --card-padding: {{ section.settings.card_padding }}px;
    --card-radius: {{ section.settings.card_border_radius }}px;
    --card-border-width: {{ section.settings.card_border_width }}px;
    --header-spacing: {{ section.settings.header_spacing }}px;

    /* Typography Sizes (calculated if needed or direct) */
    --main-title-size: 32px; /* Default fallback */

    {% if section.settings.container_width == 'custom' %}
      --container-width: {{ section.settings.custom_width }}px;
    {% elsif section.settings.container_width == 'full' %}
      --container-width: 100%;
    {% else %}
      --container-width: 1200px;
    {% endif %}
  }
{%- endstyle -%}

<div class="yd-vertical-timeline yd-vertical-timeline-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding section-padding">
  <div class="page-width container">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="timeline-header" style="text-align: {{ section.settings.header_alignment }}">
        {% if section.settings.heading != blank %}
          <h2 class="timeline-main-title {{ section.settings.heading_size }}" style="color: var(--main-title-color);">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="timeline-main-subtitle rte" style="color: var(--main-subtitle-color);">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="timeline-wrapper layout-{{ section.settings.desktop_content_position }}">
      <div class="timeline-line"></div>

      {%- for block in section.blocks -%}
        <div class="timeline-item" {{ block.shopify_attributes }}>
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            {% if block.settings.date != blank %}
              <div class="timeline-date">{{ block.settings.date }}</div>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="timeline-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <p class="timeline-subtitle">{{ block.settings.subtitle }}</p>
            {% endif %}
            {% if block.settings.description != blank %}
              <div class="timeline-description rte">{{ block.settings.description }}</div>
            {% endif %}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.1 }
    );

    document.querySelectorAll('.section-{{ section.id }}-padding .timeline-item').forEach((item) => {
      observer.observe(item);
    });
  })();
</script>

{% schema %}
{
  "name": "YD Vertical Timeline",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
