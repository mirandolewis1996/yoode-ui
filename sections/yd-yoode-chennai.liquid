<style>
  /* ================================================================ tokens */
  .yd-chennai {
    --blue: #0047ab;
    --orange: #ff591f;
    --cream: #fff7f4;
    --ink: #101114;

    /* Swap these two for the real brand faces — nothing else needs to change. */
    --font-display: 'Outfit', system-ui, sans-serif;
    --font-body: 'Kumbh Sans', system-ui, sans-serif;
  }

  .yd-chennai *,
  .yd-chennai *::before,
  .yd-chennai *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }
  .yd-chennai {
    margin: 0;
    background: #fff;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 28px;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  .yd-chennai img {
    display: block;
    max-width: 100%;
  }
  .yd-chennai a {
    color: inherit;
    text-decoration: none;
  }
  .yd-chennai h1,
  .yd-chennai h2,
  .yd-chennai h3 {
    font-family: var(--font-display);
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .yd-chennai p {
    margin: 0;
  }

  /* 1440-wide design stage, centred */
  .stage {
    position: relative;
    width: 100%;
    margin-inline: auto;
  }

  /* ------------------------------------------------------------- container
       One gutter for the whole page. Every section drops this class on its
       content wrapper, so every block starts and ends on the same line. */
  .yoode-chennai-container {
    width: 100%;
    max-width: 1850px;
    margin-inline: auto;
    padding-inline: 90px;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    line-height: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 4px;
  }
  .eyebrow--light {
    color: #fff;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 51px;
    padding: 0 24px;
    border: 0;
    border-radius: 5px;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    background: var(--orange);
    color: #fff;
    transition: background 0.18s ease;
  }
  .btn:hover {
    background: #ec4a12;
  }
  .yoode-primary-btn:hover {
    color: #fff !important;
  }
  .btn--ghost {
    background: transparent;
    color: var(--ink);
    padding: 0 10px;
  }
  .btn--ghost:hover {
    background: transparent;
    opacity: 0.72;
  }
  .btn--ghost img {
    width: 28px;
    height: 28px;
  }
  .on-blue {
    color: #fff;
  }
  :where(a, button, input, textarea, summary):focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 4px;
  }

  /* ================================================================ header */
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 40;
    height: 105px;
    display: flex;
    align-items: center;
    padding: 0 90px;
  }
  .site-header .logo {
    height: 45px;
    width: auto;
  }
  .site-header nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* ================================================================== hero */
  .hero {
    position: relative;
    padding-top: 186px;
  }
  .hero h1 {
    font-size: 72px;
    line-height: 86px;
    letter-spacing: -0.012em;
    text-align: center;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--orange);
  }

  .hero-stage {
    height: 571px;
    margin-top: -54px;
  }
  .hero-stage figure {
    position: absolute;
    margin: 0;
    overflow: hidden;
  }
  .hero-stage figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .h-a {
    left: 0;
    top: 18.21%;
    width: 18.125%;
    height: 67.77%;
  }
  .h-b {
    left: 22.361%;
    top: 32.22%;
    width: 28.264%;
    height: 32.92%;
  }
  .h-c {
    left: 59.167%;
    top: 23.12%;
    width: 15.278%;
    height: 38.53%;
  }
  .h-d {
    left: 82.986%;
    top: 0;
    width: 17.014%;
    height: 76.18%;
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    top: 540px;
    transform: translateX(-50%);
    z-index: 2;
    text-align: center;
  }
  .scroll-cue img {
    width: 40px;
    margin-inline: auto;
  }
  .scroll-cue span {
    display: block;
    margin-top: 4px;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .hero-lede {
    max-width: 1120px;
    margin: 98px auto 0;
    padding: 0 30px;
    text-align: center;
    font-family: var(--font-display);
    font-size: 54px;
    line-height: 64px;
    font-weight: 700;
    letter-spacing: -0.012em;
  }
  .hero-note {
    margin-top: 37px;
    text-align: center;
    color: #232428;
  }
  .hero-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 37px;
  }

  /* ================================================================= trust */
  .trust {
    padding-top: 248px;
  }
  .trust .stage {
    min-height: 608px;
  }
  .trust-copy {
    max-width: 520px;
    padding: 158px 0 0;
  }
  .trust h2 {
    font-size: 54px;
    line-height: 57px;
    letter-spacing: -0.012em;
    margin-top: 20px;
  }
  .trust-copy > p:not(.eyebrow) {
    margin-top: 30px;
    max-width: 486px;
    color: #232428;
  }
  .stats {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 52px 0;
    margin-top: 45px;
    max-width: 460px;
  }
  .stats b {
    display: block;
    font-family: var(--font-display);
    font-size: 51px;
    font-weight: 700;
    line-height: 47px;
    letter-spacing: -0.01em;
  }
  .stats span {
    display: block;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1;
    margin-top: 12px;
  }

  .trust-media figure {
    position: absolute;
    margin: 0;
    overflow: hidden;
  }
  .trust-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tm-big {
    left: 58.333%;
    top: 0;
    width: 35.417%;
    height: 578px;
  }
  .tm-small {
    left: 49.861%;
    top: 194px;
    width: 28.194%;
    height: 414px;
    box-shadow: 0 26px 60px rgba(0, 0, 0, 0.22);
  }

  /* =============================================================== clients */
  .clients {
    margin-top: 249px;
    overflow: hidden;
  }
  .clients-track {
    display: flex;
    align-items: center;
    gap: 85px;
    width: max-content;
    padding-left: 90px;
    animation: march 32s linear infinite;
  }
  .clients-track img {
    height: 50px;
    width: auto;
    flex: none;
  }
  @keyframes march {
    to {
      transform: translateX(-50%);
    }
  }

  /* =============================================================== contact */
  .contact {
    background: var(--cream);
    margin-top: 162px;
    padding: 93px 0 0;
    min-height: 614px;
  }
  .contact .inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 31px;
  }
  .contact h2 {
    font-size: 54px;
    line-height: 57px;
    letter-spacing: -0.012em;
    margin-top: 21px;
  }
  .contact-copy > p:not(.eyebrow) {
    margin-top: 33px;
    max-width: 442px;
    color: #232428;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 52px 31px;
    margin-top: 43px;
  }
  .field {
    position: relative;
  }
  .field--full {
    grid-column: 1/-1;
    margin-top: 9px;
  }
  .field input,
  .field textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid #dccfc9;
    background: transparent;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 24px;
    color: var(--ink);
    padding: 0 0 11px;
    resize: none;
  }
  .field textarea {
    height: 83px;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #5f5b59;
    opacity: 1;
  }
  .field :is(input, textarea):focus {
    outline: 0;
    border-bottom-color: var(--orange);
  }
  .form-grid .btn {
    margin-top: 24px;
    justify-self: start;
  }

  /* --------------------------------------------- form validation + toast */
  .field .field-msg {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 7px;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 16px;
    color: #d92d20;
    opacity: 0;
    transform: translateY(-3px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .field.is-invalid .field-msg {
    opacity: 1;
    transform: none;
  }
  .field.is-invalid :is(input, textarea) {
    border-bottom-color: #d92d20;
  }

  .yd-form .btn {
    gap: 12px;
  }
  .yd-form .btn[aria-busy='true'] {
    pointer-events: none;
    opacity: 0.75;
  }
  .yd-spin {
    display: none;
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.45);
    border-top-color: #fff;
    animation: yd-spin 0.7s linear infinite;
  }
  .yd-form .btn[aria-busy='true'] .yd-spin {
    display: block;
  }
  @keyframes yd-spin {
    to {
      transform: rotate(360deg);
    }
  }

  #yd-toasts {
    position: fixed;
    z-index: 9999;
    top: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: min(380px, calc(100vw - 32px));
    pointer-events: none;
  }
  .yd-toast {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 15px 44px 16px 16px;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(16, 17, 20, 0.07);
    box-shadow: 0 18px 44px rgba(16, 17, 20, 0.16), 0 2px 8px rgba(16, 17, 20, 0.06);
    opacity: 0;
    transform: translateY(-10px) scale(0.97);
    transition: opacity 0.3s cubic-bezier(0.2, 0.8, 0.3, 1), transform 0.3s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .yd-toast.is-in {
    opacity: 1;
    transform: none;
  }
  .yd-toast.is-out {
    opacity: 0;
    transform: translateX(20px);
  }
  .yd-toast i {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
  }
  .yd-toast--ok i {
    background: rgba(14, 143, 80, 0.12);
    color: #0e8f50;
  }
  .yd-toast--err i {
    background: rgba(217, 45, 32, 0.12);
    color: #d92d20;
  }
  .yd-toast b {
    display: block;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    line-height: 21px;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .yd-toast p {
    margin-top: 3px;
    font-size: 14px;
    line-height: 20px;
    color: #5f5b59;
  }
  .yd-toast button {
    position: absolute;
    top: 9px;
    right: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #8b8683;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease;
  }
  .yd-toast button:hover {
    background: rgba(16, 17, 20, 0.06);
  }
  .yd-toast::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    transform-origin: left;
    background: #0e8f50;
    animation: yd-timer 5.2s linear forwards;
  }
  .yd-toast--err::after {
    background: #d92d20;
  }
  @keyframes yd-timer {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0);
    }
  }
  @media (max-width: 640px) {
    #yd-toasts {
      top: auto;
      right: 16px;
      bottom: 16px;
      left: 16px;
      width: auto;
    }
    .yd-toast {
      transform: translateY(12px) scale(0.97);
    }
  }

  /* ============================================================ categories */
  .cats {
    padding-top: 176px;
    text-align: center;
  }
  .cats h2 {
    font-size: 54px;
    line-height: 57px;
    letter-spacing: -0.012em;
    margin-top: 20px;
  }
  .cats-intro {
    margin: 24px auto 0;
    max-width: 700px;
    color: #232428;
  }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 60px;
    margin-top: 53px;
    text-align: left;
  }
  .cat--mid {
    margin-top: 72px;
  }
  .cat figure {
    margin: 0;
    aspect-ratio: 380/451;
    overflow: hidden;
  }
  .cat figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cat h3 {
    font-size: 27px;
    line-height: 30px;
    letter-spacing: -0.012em;
    margin-top: 32px;
  }
  .cat .lead {
    font-weight: 700;
    font-size: 16px;
    line-height: 22px;
    margin-top: 16px;
  }
  .cat p:not(.lead) {
    font-size: 16px;
    line-height: 22px;
    margin-top: 3px;
    color: #232428;
  }
  .link-u {
    display: inline-block;
    margin-top: 23px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 3px;
  }

  /* =============================================================== marquee */
  .marquee {
    margin-top: 251px;
    overflow: hidden;
  }
  .marquee-track {
    display: flex;
    align-items: center;
    gap: 32px;
    width: max-content;
    font-family: var(--font-display);
    font-size: 108px;
    font-weight: 700;
    line-height: 114px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    animation: march 26s linear infinite;
  }
  .marquee-track--rev {
    gap: 24px;
    animation-direction: reverse;
  }
  .marquee-track img {
    width: 78px;
    height: 78px;
    flex: none;
  }
  .scroll-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 82px;
    height: 82px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    margin: 118px auto 0;
  }

  /* ================================================================== blue */
  .blue {
    background: var(--blue);
    color: #fff;
    position: relative;
    overflow: hidden;
    margin-top: 202px;
  }
  .blue::before,
  .blue::after {
    content: '';
    position: absolute;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 50%;
  }
  .blue::before {
    width: 1240px;
    height: 1240px;
    right: -360px;
    top: 180px;
  }
  .blue::after {
    width: 1620px;
    height: 1620px;
    left: -820px;
    top: 1180px;
  }

  .why {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: 245px;
  }
  .why-img {
    height: 650px;
    overflow: hidden;
  }
  .why-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .why-body {
    padding: 206px 0 0 64px;
  }
  .why-body h2 {
    font-size: 54px;
    line-height: 57px;
    letter-spacing: -0.012em;
    margin-top: 18px;
    color: #fff;
  }
  .why-body > p {
    margin-top: 23px;
    color: rgba(255, 255, 255, 0.88);
  }
  .feature {
    margin-top: 38px;
  }
  .feature img {
    width: 26px;
    height: 26px;
  }
  .feature h3 {
    font-size: 27px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin-top: 22px;
    color: #fff;
  }
  .feature p {
    margin-top: 12px;
    color: rgba(255, 255, 255, 0.84);
  }
  .feature + .feature {
    margin-top: 47px;
  }

  /* process */
  .process {
    position: relative;
    z-index: 1;
    padding-top: 384px;
    padding-bottom: 145px;
  }
  .process-head {
    position: relative;
  }
  .process-head h2 {
    font-size: 54px;
    line-height: 58px;
    letter-spacing: -0.012em;
    color: #fff;
  }
  .pill {
    position: absolute;
    background: var(--orange);
    color: #fff;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.2;
    padding: 9px 22px;
    white-space: nowrap;
  }
  .pill-1 {
    left: 87px;
    top: -39px;
    transform: rotate(-9deg);
  }
  .pill-2 {
    left: 851px;
    top: -41px;
    transform: rotate(-9deg);
  }
  .pill-3 {
    left: 228px;
    top: 185px;
    transform: rotate(-9deg);
  }
  .pill-4 {
    left: 687px;
    top: 174px;
    transform: rotate(0deg);
  }
  .float {
    position: absolute;
    margin: 0;
    overflow: hidden;
  }
  .float img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .float-1 {
    left: 522px;
    top: -131px;
    width: 104px;
    height: 104px;
    transform: rotate(-11deg);
  }
  .float-2 {
    left: 986px;
    top: 105px;
    width: 120px;
    height: 120px;
    transform: rotate(10deg);
  }

  .steps {
    margin-top: 128px;
  }
  .step {
    display: grid;
    grid-template-columns: 300px 450px 1fr;
    align-items: start;
    min-height: 160px;
    padding: 42px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }
  .step:first-child {
    border-top: 0;
  }
  .step b {
    font-family: var(--font-display);
    font-size: 54px;
    font-weight: 700;
    line-height: 54px;
    color: var(--orange);
    letter-spacing: -0.01em;
  }
  .step h3 {
    font-size: 36px;
    font-weight: 600;
    line-height: 34px;
    letter-spacing: -0.01em;
    margin-top: 6px;
    color: #fff;
  }
  .step p {
    margin-top: 0;
    color: rgba(255, 255, 255, 0.92);
  }

  /* =========================================================== testimonial */
  .testi {
    position: relative;
  }
  .testi-bg {
    width: 100%;
    height: 903px;
    object-fit: cover;
  }
  .testi-card {
    position: absolute;
    top: 215px;
    width: 734px;
    height: 867px;
    /* sits on the page gutter, so the card lines up with every other
         section once the viewport is wider than the 1440 stage */

    padding: 242px 90px 0 90px;
    color: #fff;
    background: #241b1c center/cover no-repeat;
  }
  .testi-card .eyebrow {
    color: #fff;
    padding-top: 8px;
  }
  .testi-card h2 {
    font-size: 54px;
    line-height: 57px;
    letter-spacing: -0.012em;
    margin-top: 20px;
    color: #fff;
  }
  .testi-card blockquote {
    margin: 47px 0 0;
    font-size: 19px;
    color: #fff;
    line-height: 34px;
    max-width: 430px;
  }
  .testi-who {
    display: flex;
    align-items: center;
    gap: 19px;
    margin: 74px 0 0;
  }
  .testi-who img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .testi-who b {
    display: block;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
  }
  .testi-who span {
    display: block;
    font-size: 16px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.84);
  }

  /* every slide sits in the same grid cell, so the card is as tall as the
       longest quote and the dots never jump as slides change */
  .testi-slides {
    display: grid;
  }
  .testi-slide {
    grid-area: 1/1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.45s ease, transform 0.45s ease, visibility 0s linear 0.45s;
  }
  .testi-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .dots {
    display: flex;
    gap: 15px;
    margin: 83px 0 0;
  }
  .dots button {
    position: relative;
    width: 11px;
    height: 11px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.85);
    background: transparent;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .dots button::before {
    content: '';
    position: absolute;
    inset: -9px;
    border-radius: 50%;
  }
  .dots button:hover {
    background: rgba(255, 255, 255, 0.5);
  }
  .dots button.is-active {
    background: var(--orange);
    border-color: var(--orange);
  }

  /* ============================================================== products */
  .products {
    padding-top: 354px;
    text-align: center;
  }
  .products h2 {
    font-size: 54px;
    line-height: 57px;
    letter-spacing: -0.012em;
    margin-top: 21px;
  }
  .products-intro {
    margin: 23px auto 0;
    max-width: 690px;
    color: #232428;
  }
  .prod-grid {
    display: flex;
    gap: 26px 30px;
    margin-top: 85px;
    text-align: center;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }
  .prod-grid article.prod {
    width: 32%;
  }

  .prod figure {
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .prod figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prod h3 {
    font-size: 27px;
    font-weight: 600;
    margin-top: 14px;
    transition: color 0.2s ease;
  }
  .prod p {
    font-size: 16px;
    margin-top: 2px;
    color: #232428;
  }
  .prod-link {
    display: block;
    color: inherit;
  }
  .prod-link figure img {
    transition: transform 0.5s ease;
  }
  .prod-link:hover figure img {
    transform: scale(1.045);
  }
  .prod-link:hover h3 {
    color: var(--orange);
  }
  .products .btn {
    margin-top: 96px;
  }

  /* =================================================================== faq */
  .faq {
    padding-top: 150px;
  }
  .faq-inner {
    display: grid;
    gap: 70px;
    grid-template-columns: 650px 1fr;
  }
  .faq-img {
    width: 650px;
    height: 651px;
    overflow: hidden;
  }
  .faq-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .faq-body .eyebrow {
    letter-spacing: 0.14em;
    font-size: 15px;
    color: var(--blue);
  }
  .faq-body h2 {
    font-size: 54px;
    line-height: 57px;
    letter-spacing: -0.012em;
    margin-top: 28px;
  }
  .acc {
    border-bottom: 0;
  }
  .acc:first-of-type {
    margin-top: 47px;
  }
  .acc:last-of-type {
    border-bottom: 0;
  }
  .acc summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    gap: 24px;
    padding: 22px 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 28px;
    letter-spacing: -0.01em;
  }
  .acc summary::-webkit-details-marker {
    display: none;
  }
  .acc .ar {
    margin-left: auto;
    flex: none;
    color: var(--orange);
    margin-top: 9px;
    transition: transform 0.25s ease;
  }
  .acc[open] .ar {
    transform: rotate(45deg);
  }
  .acc[open] summary {
    padding-bottom: 11px;
  }
  .acc p {
    margin: 0 0 17px;
    color: #232428;
    max-width: 620px;
  }

  /* ================================================================= strip */
  .strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin: 92px auto 0;
  }
  .strip img {
    width: 100%;
    height: 360px;
    object-fit: cover;
  }
  .ig {
    position: absolute;
    left: 50%;
    top: 39.7%;
    transform: translate(-50%, -50%);
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ================================================================ footer */
  .site-footer {
    background: var(--blue);
    color: #fff;
    padding-top: 116px;
    padding-bottom: 116px;
    text-align: center;
  }
  .site-footer h2 {
    font-size: 54px;
    line-height: 64px;
    color: #fff;
    letter-spacing: -0.012em;
  }
  .site-footer .sub {
    margin-top: 32px;
    line-height: 32px;
    color: rgba(255, 255, 255, 0.94);
  }
  .site-footer .sub b {
    font-weight: 700;
  }
  .footer-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 57px;
  }
  .footer-logo {
    width: 663px;
    max-width: 78%;
    margin: 130px auto 0;
  }
  .footer-bar {
    max-width: 1440px;
    margin: 32px auto 0;
    padding: 0 90px;
  }
  .footer-bar-in {
    border-top: 1px solid rgba(255, 255, 255, 0.34);
    padding: 37px 0 37px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .footer-bar a {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

