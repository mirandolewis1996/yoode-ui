<script>
  (function () {
    var SECTION_ID = {{ section.id | json }};
    var DRAFT_KEY = 'yd-contact-draft';

    var TXT = {
      okTitle: 'Request sent',
      ok: {{ section.settings.success_message | json }} ||
        'Thanks! We have your details and our team will get back to you shortly.',
      failTitle: 'Could not send',
      fail: {{ section.settings.error_message | json }} ||
        'Something went wrong. Please try again, or reach us on WhatsApp.',
      invalidTitle: 'Check your details'
    };

    var ICON = {
      ok:
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
        'stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>',
      err:
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
        'stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">' +
        '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.2"/><path d="M12 16.4h.01"/></svg>'
    };

    var CLOSE_ICON =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
      'stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>';

    /* --------------------------------------------------------------- toasts */
    function host() {
      var el = document.getElementById('yd-toasts');
      if (!el) {
        el = document.createElement('div');
        el.id = 'yd-toasts';
        el.setAttribute('role', 'status');
        el.setAttribute('aria-live', 'polite');
        document.body.appendChild(el);
      }
      return el;
    }

    function toast(kind, title, message) {
      var el = document.createElement('div');
      el.className = 'yd-toast yd-toast--' + kind;
      el.innerHTML =
        '<i>' + ICON[kind] + '</i>' +
        '<div><b></b><p></p></div>' +
        '<button type="button" aria-label="Dismiss">' + CLOSE_ICON + '</button>';
      el.querySelector('b').textContent = title;
      el.querySelector('p').textContent = message;
      host().appendChild(el);

      requestAnimationFrame(function () { el.classList.add('is-in'); });

      var timer = setTimeout(close, 5200);
      function close() {
        clearTimeout(timer);
        el.classList.add('is-out');
        setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 320);
      }
      el.querySelector('button').addEventListener('click', close);
    }

    /* ---------------------------------------------------------- url hygiene */
    /* Shopify sends a rejected submission back with every field in the query
       string, so the failure is re-evaluated on each reload and the same
       error is rendered again. Once the result has been shown, drop those
       parameters: a refresh then loads a clean page with no verdict at all. */
    function cleanUrl() {
      try {
        if (!window.history || !history.replaceState) return;
        var query = window.location.search;
        if (query.length < 2) return;

        var kept = query.slice(1).split('&').filter(function (pair) {
          var key = pair.split('=')[0] || '';
          try { key = decodeURIComponent(key); } catch (e) {}
          return !(
            key === 'contact_posted' ||
            key === 'form_type' ||
            key === 'utf8' ||
            key === 'g-recaptcha-response' ||
            key.indexOf('contact[') === 0
          );
        });

        if (kept.length === query.slice(1).split('&').length) return;

        history.replaceState(
          null,
          '',
          window.location.pathname + (kept.length ? '?' + kept.join('&') : '') + window.location.hash
        );
      } catch (e) {}
    }

    /* ------------------------------------------------------------------ init */
    /* The banner lead form posts to Shopify's contact form. Each yd-form on
       the page is validated on its own;
       the result of a post is shown once, for the form that was submitted. */
    var LAST_KEY = 'yd-contact-last';

    function draftKey(form) { return DRAFT_KEY + ':' + form.id; }

    function saveDraft(form) {
      try {
        var draft = {};
        Array.prototype.forEach.call(form.querySelectorAll('input, textarea'), function (el) {
          if (!el.name || el.type === 'hidden') return;
          if (el.type === 'radio') { if (el.checked) draft[el.name] = el.value; }
          else draft[el.name] = el.value;
        });
        sessionStorage.setItem(draftKey(form), JSON.stringify(draft));
        sessionStorage.setItem(LAST_KEY, form.id);
      } catch (e) {}
    }

    function clearDraft(form) {
      try {
        sessionStorage.removeItem(draftKey(form));
        sessionStorage.removeItem(LAST_KEY);
      } catch (e) {}
    }

    function restoreDraft(form) {
      try {
        var raw = sessionStorage.getItem(draftKey(form));
        if (!raw) return;
        var draft = JSON.parse(raw);
        Array.prototype.forEach.call(form.querySelectorAll('input, textarea'), function (el) {
          if (!el.name || el.type === 'hidden' || !(el.name in draft)) return;
          if (el.type === 'radio') el.checked = el.value === draft[el.name];
          else if (el.getAttribute('data-yd-fallback-email') && draft[el.name] === el.getAttribute('data-yd-fallback-email')) el.value = '';
          else el.value = draft[el.name];
        });
      } catch (e) {}
    }

    function bind(form) {
      if (form.getAttribute('data-yd-bound') === '1') return;
      form.setAttribute('data-yd-bound', '1');

      /* --------------------------------------------------------- validation */
      var EMAIL = /^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i;
      var fields = Array.prototype.slice.call(form.querySelectorAll('[required], [data-yd-validate], [data-yd-group]'));
      var submitBtn = form.querySelector('[type="submit"]');
      var attempted = false;

      function wrap(el) { return el.closest('.field'); }

      function setMsg(el, msg) {
        var box = wrap(el);
        if (!box) return;
        var slot = box.querySelector('.field-msg');
        if (slot) slot.textContent = msg || '';
        box.classList.toggle('is-invalid', !!msg);
        el.setAttribute('aria-invalid', msg ? 'true' : 'false');
      }

      function isGroup(el) { return el.hasAttribute('data-yd-group'); }

      function check(el) {
        /* Chip group (radio buttons): one option must be picked. */
        if (isGroup(el)) {
          var picked = el.querySelector('input[type="radio"]:checked');
          setMsg(el, picked ? '' : el.getAttribute('data-msg') || 'Please select an option.');
          return !!picked;
        }

        var value = (el.value || '').trim();
        var msg = '';
        if (!value) {
          if (el.required) msg = el.getAttribute('data-msg') || 'This field is required.';
        } else if (el.type === 'email' && !EMAIL.test(value)) {
          msg = 'Enter a valid email address.';
        } else if (el.type === 'tel' && value.replace(/[^0-9]/g, '').length < 7) {
          msg = 'Enter a valid phone number.';
        }
        setMsg(el, msg);
        return !msg;
      }

      function invalidFields() {
        var bad = [];
        fields.forEach(function (el) { if (!check(el)) bad.push(el); });
        return bad;
      }

      function reportInvalid(bad) {
        toast(
          'err',
          TXT.invalidTitle,
          bad.length === 1
            ? 'One field still needs your attention.'
            : bad.length + ' fields still need your attention.'
        );
        var focusEl = isGroup(bad[0]) ? bad[0].querySelector('input[type="radio"]') : bad[0];
        if (focusEl) focusEl.focus({ preventScroll: true });
        bad[0].scrollIntoView({ block: 'center', behavior: 'smooth' });
      }

      fields.forEach(function (el) {
        if (isGroup(el)) {
          /* Picking an option clears the group's error straight away. */
          el.addEventListener('change', function () {
            if (el.classList.contains('is-invalid')) check(el);
          });
          return;
        }
        el.addEventListener('blur', function () {
          if (attempted || (el.value || '').trim()) check(el);
        });
        el.addEventListener('input', function () {
          var box = wrap(el);
          if (box && box.classList.contains('is-invalid')) check(el);
        });
      });

      /* ------------------------------------------------------------ submit */
      /* The submission itself is a normal form post. Shopify's spam protection
         adds its token to that post and only then does Shopify deliver the
         email - a background fetch has no token, so it gets answered with the
         challenge page and nothing is ever sent. So this script only gates the
         submission: it blocks it while a field is empty, and otherwise steps
         aside and lets the browser (and Shopify's own script) do the post. */
      form.noValidate = true;

      var allowSubmit = false;
      var nativeSubmit = HTMLFormElement.prototype.submit;

      /* Blocks the delayed form.submit() that Shopify's spam-protection script
         fires a few seconds after a click - that call raises no submit event,
         so preventDefault cannot reach it. */
      try {
        form.submit = function () { if (allowSubmit) nativeSubmit.call(form); };
      } catch (e) {}

      function busy(state) {
        if (!submitBtn) return;
        submitBtn.disabled = state;
        if (state) submitBtn.setAttribute('aria-busy', 'true');
        else submitBtn.removeAttribute('aria-busy');
      }

      /* Stop an invalid click before it can become a submit event, so no other
         listener on the form ever starts a submission of its own. */
      if (submitBtn) {
        submitBtn.addEventListener('click', function (event) {
          if (allowSubmit) return;
          attempted = true;
          var bad = invalidFields();
          if (bad.length) {
            event.preventDefault();
            event.stopImmediatePropagation();
            reportInvalid(bad);
          }
        }, true);
      }

      function onSubmit(event) {
        if (allowSubmit) return;

        attempted = true;

        var bad = invalidFields();
        if (bad.length) {
          event.preventDefault();
          event.stopImmediatePropagation();
          reportInvalid(bad);
          return;
        }

        /* Optional email left empty: Shopify still needs one to deliver the
           enquiry, so fall back to the store's own address. */
        var email = form.querySelector('[data-yd-fallback-email]');
        if (email && !(email.value || '').trim()) {
          email.value = email.getAttribute('data-yd-fallback-email') || '';
        }

        /* Valid: let the post through untouched. */
        allowSubmit = true;
        saveDraft(form);
        setTimeout(function () { busy(true); }, 0);
      }

      /* Capture on document runs before any listener bound to the form. */
      document.addEventListener('submit', function (event) {
        if (event.target === form) onSubmit(event);
      }, true);
      form.addEventListener('submit', onSubmit, true);
    }

    function init() {
      var root = document.getElementById('shopify-section-' + SECTION_ID) || document;
      var forms = Array.prototype.slice.call(root.querySelectorAll('form.yd-form'));
      if (!forms.length) return;
      forms.forEach(bind);

      if (root.getAttribute('data-yd-result') === '1') return;
      root.setAttribute('data-yd-result', '1');

      /* ------------------------------------------- result of that page post */
      /* Shopify renders the result flag in every contact form on the page, so
         show it only for the form this visitor actually submitted. */
      var last = null;
      try { last = sessionStorage.getItem(LAST_KEY); } catch (e) {}
      var target = (last && document.getElementById(last)) || forms[0];
      if (forms.indexOf(target) === -1) target = forms[0];

      var flag = target.querySelector('.yd-flag');
      if (flag && flag.getAttribute('data-status') === 'success') {
        clearDraft(target);
        toast('ok', TXT.okTitle, TXT.ok);
      } else if (flag) {
        restoreDraft(target);
        clearDraft(target);
        toast('err', TXT.failTitle, (flag.textContent || '').trim() || TXT.fail);
        target.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } else {
        forms.forEach(clearDraft);
      }

      cleanUrl();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();

    /* Theme editor swaps the section out and back in; re-bind to the new form. */
    document.addEventListener('shopify:section:load', init);
  })();

  /* ========================================================== testimonials */
  (function () {
    var SECTION_ID = {{ section.id | json }};
    var DELAY = 10000;

    function init() {
      var root = document.getElementById('shopify-section-' + SECTION_ID) || document;
      var card = root.querySelector('.testi-card');
      if (!card || card.getAttribute('data-yd-slider') === '1') return;

      var slides = Array.prototype.slice.call(card.querySelectorAll('[data-yd-slide]'));
      var dots = Array.prototype.slice.call(card.querySelectorAll('[data-yd-dot]'));
      if (slides.length < 2) return;
      card.setAttribute('data-yd-slider', '1');

      var index = 0;
      var timer = null;
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function show(next) {
        index = (next + slides.length) % slides.length;

        slides.forEach(function (el, i) {
          var on = i === index;
          el.classList.toggle('is-active', on);
          el.setAttribute('aria-hidden', on ? 'false' : 'true');
        });

        dots.forEach(function (el, i) {
          var on = i === index;
          el.classList.toggle('is-active', on);
          if (on) el.setAttribute('aria-current', 'true');
          else el.removeAttribute('aria-current');
        });
      }

      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      function start() {
        stop();
        /* No auto-advance for visitors who asked for less motion, and none
           while the tab is in the background. */
        if (still || document.hidden) return;
        timer = setInterval(function () { show(index + 1); }, DELAY);
      }

      dots.forEach(function (el, i) {
        el.addEventListener('click', function () {
          show(i);
          start(); /* a click restarts the countdown from now */
        });
      });

      card.addEventListener('mouseenter', stop);
      card.addEventListener('mouseleave', start);
      card.addEventListener('focusin', stop);
      card.addEventListener('focusout', start);
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop();
        else start();
      });

      show(0);
      start();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();

    document.addEventListener('shopify:section:load', init);
  })();
</script>

