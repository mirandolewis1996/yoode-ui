  /* =====================================================================
       YD Yoode Chennai
       Section styles, organised section by section:
       .yd-chennai (page wrapper) → .yd-chennai-<section>__<element>
       ===================================================================== */

  /* ================================================================ banner */
  .yd-chennai .yd-chennai-banner {
    width: 100%;
    background: #fafafa;
    padding: 40px 0 80px;
  }

  .yd-chennai .yd-chennai-banner__container {
    width: 100%;
    max-width: 1850px;
    margin-inline: auto;
    padding-inline: 90px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 800px);
    gap: 80px;
    align-items: start;
  }

  /* ---------------------------------------------------------- left content */
  .yd-chennai .yd-chennai-banner__content {
    padding-top: 8px;
  }

  .yd-chennai .yd-chennai-banner__badge {
    display: inline-block;
    padding: 7px 11px;
    border-radius: 999px;
    background: #fff1ea;
    color: #c2410c;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
  }

  .yd-chennai .yd-chennai-banner__title {
    font-size: 56px;
    line-height: 1.25;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  .yd-chennai .yd-chennai-banner__title em {
    font-style: normal;
    color: var(--orange);
  }

  .yd-chennai .yd-chennai-banner__text {
    margin-top: 22px;
    max-width: 760px;
    font-size: 18px;
    line-height: 1.6;
    color: #5f5b59;
  }

  .yd-chennai .yd-chennai-banner__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 40px 0 0;
    padding: 0 0 44px;
    list-style: none;
    border-bottom: 1px solid #dcdcdc;
    max-width: 880px;
  }

  .yd-chennai .yd-chennai-banner__stat {
    padding: 0 24px;
    border-left: 1px solid #dcdcdc;
  }

  .yd-chennai .yd-chennai-banner__stat:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .yd-chennai .yd-chennai-banner__stat b {
    display: block;
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ink);
  }

  .yd-chennai .yd-chennai-banner__stat span {
    display: block;
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.3;
    color: #8b8683;
  }

  .yd-chennai .yd-chennai-banner__talk {
    margin-top: 30px;
  }

  .yd-chennai .yd-chennai-banner__talk-label {
    font-size: 16px;
    line-height: 1.4;
    color: #8b8683;
  }

  .yd-chennai .yd-chennai-banner__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
    padding: 14px 42px 14px 26px;
    border: 2px solid #25d366;
    border-radius: 999px;
    background: #fff;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
    transition: background 0.18s ease;
  }

  .yd-chennai .yd-chennai-banner__whatsapp:hover {
    background: #effcf4;
  }

  .yd-chennai .yd-chennai-banner__whatsapp img {
    width: 28px;
    height: 28px;
    flex: none;
  }

  .yd-chennai .yd-chennai-banner__trusted {
    margin-top: 26px;
    font-size: 15px;
    font-style: italic;
    line-height: 1.5;
    color: #8b8683;
  }

  /* ------------------------------------------------------------- form card */
  .yd-chennai .yd-chennai-banner__card {
    position: relative;
    padding: 28px 36px 28px;
    border: 1px solid #e4e4e4;
    border-radius: 20px;
    background: #fff;
  }

  .yd-chennai .yd-chennai-banner__card-tag {
    display: inline-block;
    padding: 7px 12px;
    border-radius: 999px;
    background: #fff1ea;
    color: #c2410c;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 3px;
  }

  .yd-chennai .yd-chennai-banner__card-title {
    margin-top: 8px;
    font-size: 32px;
    line-height: 1.25;
    color: var(--ink);
  }

  .yd-chennai .yd-chennai-banner__card-text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.6;
    color: #5f5b59;
  }

  .yd-chennai .yd-chennai-banner__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 13px;
  }

  .yd-chennai .yd-chennai-banner__label {
    display: block;
    margin-bottom: 10px;
    padding: 0;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .yd-chennai .yd-chennai-banner__label small {
    margin-left: 6px;
    font-size: 13px;
    font-weight: 400;
    color: #8b8683;
  }

  /* inputs — overrides the underline style of the contact-section .field */
  .yd-chennai .yd-chennai-banner__field input {
    width: 100%;
    height: 40px;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid #dcdcdc;
    border-radius: 8px;
    background: #f5f5f5;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1;
    color: var(--ink);
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .yd-chennai .yd-chennai-banner__field input::placeholder {
    font-size: 14px;
    color: #a3a09e;
    opacity: 1;
  }

  .yd-chennai .yd-chennai-banner__field input:focus {
    outline: 0;
    border-color: var(--orange);
    background: #fff;
  }

  .yd-chennai .yd-chennai-banner__field.is-invalid input {
    border-color: #d92d20;
  }

  .yd-chennai .yd-chennai-banner__field .field-msg {
    position: static;
    display: none;
    margin-top: 6px;
  }

  .yd-chennai .yd-chennai-banner__field.is-invalid .field-msg {
    display: block;
  }

  /* chip groups (radio buttons) */
  .yd-chennai .yd-chennai-banner__group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .yd-chennai .yd-chennai-banner__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .yd-chennai .yd-chennai-banner__chips--half {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .yd-chennai .yd-chennai-banner__chip {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .yd-chennai .yd-chennai-banner__chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
