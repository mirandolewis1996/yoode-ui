       heading moves down to keep them inside the section */
  .yd-chennai .process-head {
    margin-top: 131px;
  }

  .yd-chennai .testi,
  .yd-chennai .strip {
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
  }

  /* the testimonial card hangs 179px below the photo (215 + 867 - 903);
