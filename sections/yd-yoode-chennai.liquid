{%- comment -%}
  WhatsApp link, built once for every "Chat on Whatsapp" button.
  Empty number falls back to the contact form, so nothing breaks before it's set.
{%- endcomment -%}
{%- assign yd_wa_number = section.settings.whatsapp_number
  | remove: ' '
  | remove: '-'
  | remove: '('
  | remove: ')'
  | remove: '+'
-%}
{%- if yd_wa_number != blank -%}
  {%- assign yd_wa_msg = section.settings.whatsapp_message
    | default: 'Hi Yoode, I’d like a quote for a bulk custom order. Please share the options and pricing.'
  -%}
  {%- assign yd_wa_text = yd_wa_msg | url_encode -%}
  {%- assign yd_wa_link = 'https://wa.me/' | append: yd_wa_number | append: '?text=' | append: yd_wa_text -%}
  {%- assign yd_wa_attrs = 'target="_blank" rel="noopener"' -%}
{%- else -%}
  {%- assign yd_wa_link = '#quote' -%}
  {%- assign yd_wa_attrs = '' -%}
{%- endif -%}

<div id="top" class="yd-chennai">
  <!-- ================================================================ banner -->
  <section class="yd-chennai-banner" id="quote">
    <div class="yd-chennai-banner__container">
      <div class="yd-chennai-banner__content">
        <p class="yd-chennai-banner__badge">4.9/5 Google Rating · 150+ Corporates Served</p>

        <h1 class="yd-chennai-banner__title">
          Bulk Custom T-Shirts &amp; <br>
          Team Apparel, <em>Delivered Fast</em>
        </h1>

        <p class="yd-chennai-banner__text">
          From corporate kits to custom jerseys for schools, colleges &amp; sports teams. Orders from 50 to 5,000+
          pieces. No artwork ready? No problem.
        </p>

        <ul class="yd-chennai-banner__stats">
          <li class="yd-chennai-banner__stat"><b>4.9/5</b><span>Google Rating</span></li>
          <li class="yd-chennai-banner__stat"><b>150+</b><span>Corporates Served</span></li>
          <li class="yd-chennai-banner__stat"><b>1K+</b><span>Units / Day</span></li>
          <li class="yd-chennai-banner__stat"><b>5</b><span>Experience Centres</span></li>
        </ul>

        <div class="yd-chennai-banner__talk">
          <p class="yd-chennai-banner__talk-label">Prefer to talk now?</p>
          <a class="yd-chennai-banner__whatsapp" href="{{ yd_wa_link }}" {{ yd_wa_attrs }}>
            <img src="{{ 'icon-whatsapp.png' | asset_url }}" alt="" width="28" height="28">
            <span>Chat on WhatsApp</span>
          </a>
          <p class="yd-chennai-banner__trusted">Trusted by teams at TCS, Infosys, UST and 150+ other organisations.</p>
        </div>
      </div>

      <div class="yd-chennai-banner__card">
        <p class="yd-chennai-banner__card-tag">High-Intent Lead Form</p>
        <h2 class="yd-chennai-banner__card-title">Get a Bulk Order Quote from YOODE</h2>
        <p class="yd-chennai-banner__card-text">
          Custom sportswear, teamwear &amp; branded apparel for teams, clubs, businesses and events. Tell us what you
          need and our team will contact you.
        </p>

        {%- assign yd_banner_form_id = 'yd-banner-' | append: section.id -%}
        {%- assign yd_banner_source = section.settings.source_label
          | default: 'Yoode Chennai Landing Page'
          | append: ' - Banner Form'
        -%}

        {% form 'contact', id: yd_banner_form_id, class: 'yd-form yd-chennai-banner__form' %}
          {%- if form.posted_successfully? -%}
            <div class="yd-flag" data-status="success" hidden></div>
          {%- else -%}
            {%- assign yd_errors = form.errors | default_errors | strip_html | strip_newlines | strip -%}
            {%- if yd_errors != blank -%}
              <div class="yd-flag" data-status="error" hidden>{{ yd_errors }}</div>
            {%- endif -%}
          {%- endif -%}

          <input type="hidden" name="contact[source]" value="{{ yd_banner_source | escape }}">

          <div class="field yd-chennai-banner__field">
            <label class="yd-chennai-banner__label" for="{{ yd_banner_form_id }}-name">Full Name *</label>
            <input
              id="{{ yd_banner_form_id }}-name"
              type="text"
              name="contact[name]"
              placeholder="e.g. Arun Kumar"
              autocomplete="name"
              required
              data-msg="Please enter your full name."
            >
            <span class="field-msg"></span>
          </div>

          <div class="field yd-chennai-banner__field">
            <label class="yd-chennai-banner__label" for="{{ yd_banner_form_id }}-phone">WhatsApp Number *</label>
            <input
              id="{{ yd_banner_form_id }}-phone"
              type="tel"
              name="contact[phone]"
              placeholder="+91 98765 43210"
              autocomplete="tel"
              inputmode="tel"
              required
              data-msg="Please enter your WhatsApp number."
            >
            <span class="field-msg"></span>
          </div>

          <div class="field yd-chennai-banner__field">
            <label class="yd-chennai-banner__label" for="{{ yd_banner_form_id }}-email">
              Email <small>(optional)</small>
            </label>
            {%- comment -%}
              Optional for the visitor, but Shopify's contact form needs an email to
              deliver the enquiry. When left empty, the script fills in the store's
              own address (data-yd-fallback-email) just before the post.
            {%- endcomment -%}
            <input
              id="{{ yd_banner_form_id }}-email"
              type="email"
              name="contact[email]"
              placeholder="name@company.com"
              autocomplete="email"
              data-yd-validate
              data-yd-fallback-email="{{ shop.email | escape }}"
            >
            <span class="field-msg"></span>
          </div>

          <fieldset
            class="field yd-chennai-banner__field yd-chennai-banner__group"
            data-yd-group
            data-msg="Please select what you are looking for."
          >
            <legend class="yd-chennai-banner__label">What are you looking for?</legend>
            <div class="yd-chennai-banner__chips">
              {%- assign yd_looking_for = 'Sports Teamwear,Corporate / Office Wear,Sports Club Apparel,Event / Group T-Shirts,Custom Merchandise,Other'
                | split: ','
              -%}
              {%- for option in yd_looking_for -%}
                <label class="yd-chennai-banner__chip">
                  <input type="radio" name="contact[Looking for]" value="{{ option | escape }}">
                  <span>{{ option }}</span>
                </label>
              {%- endfor -%}
            </div>
            <span class="field-msg"></span>
          </fieldset>

          <fieldset
            class="field yd-chennai-banner__field yd-chennai-banner__group"
            data-yd-group
            data-msg="Please select an approximate quantity."
          >
            <legend class="yd-chennai-banner__label">Approximate Quantity</legend>
            <div class="yd-chennai-banner__chips">
              {%- assign yd_quantity = '10–25,26–50,51–100,101–250,250+' | split: ',' -%}
              {%- for option in yd_quantity -%}
                <label class="yd-chennai-banner__chip">
                  <input type="radio" name="contact[Quantity]" value="{{ option | escape }}">
                  <span>{{ option }}</span>
                </label>
              {%- endfor -%}
            </div>
            <span class="field-msg"></span>
          </fieldset>

          <fieldset
            class="field yd-chennai-banner__field yd-chennai-banner__group"
            data-yd-group
            data-msg="Please select when you need the order."
          >
            <legend class="yd-chennai-banner__label">When do you need the order?</legend>
            <div class="yd-chennai-banner__chips yd-chennai-banner__chips--half">
              {%- assign yd_timeline = 'Within 7 days,1–2 weeks,2–4 weeks,Just enquiring' | split: ',' -%}
              {%- for option in yd_timeline -%}
                <label class="yd-chennai-banner__chip">
                  <input type="radio" name="contact[Timeline]" value="{{ option | escape }}">
                  <span>{{ option }}</span>
                </label>
              {%- endfor -%}
            </div>
            <span class="field-msg"></span>
          </fieldset>

          <button class="btn yoode-primary-btn yd-chennai-banner__submit" type="submit">
            <span class="yd-spin" aria-hidden="true"></span>
            <span>Get Quote &rarr;</span>
          </button>

          <p class="yd-chennai-banner__note">
            By submitting, you agree to be contacted via call / WhatsApp about your enquiry.
          </p>
        {% endform %}
      </div>
    </div>
  </section>

