  /* ======================================================= section spacing
       One vertical rhythm for every section below the banner:
       80px top and bottom on desktop, 40px on mobile. The old per-section
       margin/padding values above are reset here, so change spacing only in
       this block. Full-bleed media rows (testimonial image, image strip) sit
       flush and take their spacing from the sections around them. */
  .yd-chennai .trust,
  .yd-chennai .clients,
  .yd-chennai .cats,
  .yd-chennai .marquee,
  .yd-chennai .blue,
  .yd-chennai .products,
