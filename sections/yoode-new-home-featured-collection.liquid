{%- liquid
  # Product source: "collection" = products from the chosen collection,
  # "custom" = the card blocks (each can pick a product or use its own image/text)
  assign featured = section.settings.collection
  assign show_products = false
  if section.settings.source == 'collection' and featured != blank and featured.products_count > 0
    assign show_products = true
  endif
-%}

<div
  class="yn-section yn-source yn-source--featured-collection yn-featured-collection color-{{ section.settings.color_scheme }}"
  data-yn-layout="{{ section.settings.custom_container }}" data-yn-container="{{ section.settings.container_type | default: 'container' }}" style="{% render 'yoode-new-home-container-settings', container_settings: section.settings %}--yn-source-background: {{ section.settings.source_background | default: '#faf9f7' }}; --yn-pt: {{ section.settings.padding_top | divided_by: 10.0 }}rem; --yn-pb: {{ section.settings.padding_bottom | divided_by: 10.0 }}rem;"
>
  <div class="yn-featured-collection__panel">
    <div class="yn-container yn-container--narrow">
      <div class="yn-source-products-header">
      {% render 'yoode-new-home-heading',
        subtitle: section.settings.subtitle,
        title: section.settings.title,
        description: section.settings.description,
        align: 'center'
      %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="yn-src-ml-cta-button" href="{{ section.settings.button_link }}">
          <span>{{ section.settings.button_label | escape }}</span>
          <span class="yn-src-ml-cta-icon-wrapper" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14m-6-6 6 6-6 6"/>
            </svg>
          </span>
        </a>
      {% endif %}
      </div>
      <yoode-new-home-featured-collection
        data-error-label="{{ section.settings.error_label | escape }}"
      >
        <yoode-new-home-reveal>
          <ul class="yn-featured-collection__grid{% if section.settings.show_ranks %} yn-source-products--ranked{% endif %}" role="list">
            {%- if show_products -%}
              {%- for product in featured.products limit: section.settings.products_to_show -%}
                <li data-yn-reveal style="--yn-step: {{ forloop.index0 | modulo: 4 }};">
                  {% render 'yoode-new-home-product-card',
                    product: product,
                    card_settings: section.settings,
                    section_id: section.id
                  %}
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for block in section.blocks limit: section.settings.products_to_show -%}
                <li data-yn-reveal style="--yn-step: {{ forloop.index0 | modulo: 4 }};" {{ block.shopify_attributes }}>
                  {%- if block.settings.product != blank -%}
                    {%- liquid
                      # Typed title wins over the product title ("Product title" is the old placeholder, ignored)
                      assign typed_title = block.settings.title | strip
                      if typed_title == 'Product title'
                        assign typed_title = blank
                      endif
                      assign card_title_override = block.settings.product_title | strip | default: typed_title
                    -%}
                    {% render 'yoode-new-home-product-card',
                      product: block.settings.product,
                      title_override: card_title_override,
                      image_override: block.settings.image,
                      card_settings: section.settings,
                      section_id: section.id
                    %}
                  {%- else -%}
                    {% render 'yoode-new-home-product-card',
                      block: block,
                      card_settings: section.settings,
                      section_id: section.id
                    %}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </yoode-new-home-reveal>
        <p class="yn-featured-collection__status" role="status" aria-live="polite" data-yn-status></p>
      </yoode-new-home-featured-collection>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YN Featured Collection",
  "tag": "section",
