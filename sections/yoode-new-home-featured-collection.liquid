      "default": "Explore all products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_ranks",
      "label": "Number the product cards",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "paragraph",
          "content": "Shown when Product source is \"Custom cards\". Pick a product to show it from Shopify, or leave it empty and fill in the image and details below."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product (optional)",
          "info": "The card links to this product and uses its price and sizes. An uploaded image replaces the product image. Custom title or Title below replaces the product title when filled in."
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Custom title (optional)",
          "info": "Replaces the picked product's title on this card. You can also just fill in Title below."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the selected product's image. Leave empty to use the product image."
        },
        {
          "type": "header",
          "content": "Custom card (when no product is picked)"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Demo image file (used when no image is uploaded)",
          "info": "Theme asset file name, e.g. yoode-new-home-img-mens-polo.webp"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Card title. Also replaces the picked product's title when filled in."
        },
        {
          "type": "text",
          "id": "vendor",
          "label": "Vendor",
          "default": "YOODE"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Discount badge",
          "default": "- 20%"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag badge"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating",
          "default": "4.9"
        },
        {
          "type": "text",
          "id": "sizes",
          "label": "Sizes",
          "info": "Comma separated, e.g. S, M, L, XL. Leave empty to hide the size picker."
        },
