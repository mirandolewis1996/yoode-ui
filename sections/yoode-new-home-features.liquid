{%- liquid
  assign columns = section.settings.columns_desktop | default: 3
  assign group_size = columns | times: 2
-%}
<div class="color-{{ section.settings.color_scheme }} yn-source yn-source--features yn-src-why-choose-section"
  data-yn-layout="{{ section.settings.custom_container }}" data-yn-container="{{ section.settings.container_type | default: 'container' }}" style="{% render 'yoode-new-home-container-settings', container_settings: section.settings %}--yn-feature-cols: {{ columns }}; --yn-feature-height: {{ section.settings.grid_height | default: 850 }}px; --yn-feature-gap: {{ section.settings.card_gap | default: 20 }}px; --yn-feature-radius: {{ section.settings.card_radius | default: 32 }}px; --yn-feature-card-bg: {{ section.settings.card_background | default: '#ebebeb' }}; --yn-source-background: {{ section.settings.source_background | default: '#ffffff' }}; --yn-pt: {{ section.settings.padding_top }}px; --yn-pb: {{ section.settings.padding_bottom }}px;">
  <div class="yn-src-why-choose-container">
    {% render 'yoode-new-home-heading', subtitle: section.settings.subtitle, title: section.settings.title, description: section.settings.description %}
    <div class="yn-src-why-choose-grid">
      {% for block in section.blocks %}
        {%- liquid
          assign slot = forloop.index0 | modulo: group_size
          assign column_index = slot | modulo: columns
          assign column = column_index | plus: 1
          assign group_index = forloop.index0 | divided_by: group_size
          assign row_offset = group_index | times: 5
          assign row_span = 3
          if slot < columns
            assign row_start = row_offset | plus: 1
            if column_index == 0
              assign row_span = 2
            endif
          else
            if column_index == 0
              assign row_start = row_offset | plus: 3
            else
              assign row_start = row_offset | plus: 4
              assign row_span = 2
            endif
          endif
        -%}
        <article class="yn-src-why-choose-card {% if row_span == 2 %}yn-feature-card--short{% else %}yn-feature-card--tall{% endif %} yn-source-feature--{{ block.settings.image_size }}{% if block.settings.image_layout == 'side' %} yn-source-feature--side{% endif %}"
          style="--yn-card-column: {{ column }}; --yn-card-row: {{ row_start }}; --yn-card-span: {{ row_span }}; --yn-feature-image-scale: {{ block.settings.image_scale | default: 100 | divided_by: 100.0 }};"
          {{ block.shopify_attributes }}>
          <div class="yn-src-why-choose-card-content">
            <h3 class="yn-src-why-choose-card-title">
              <span class="yn-src-why-choose-card-icon-wrap">
                {% if block.settings.icon_image != blank %}
                  {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                {% else %}
                  {% render 'yoode-new-home-icon', icon: block.settings.icon %}
                {% endif %}
              </span>
              <span>{{ block.settings.title | escape }}</span>
            </h3>
            <div class="yn-src-why-choose-card-text">{{ block.settings.text }}</div>
          </div>
          <div class="yn-src-why-choose-card-img-wrap">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: class: 'yn-src-why-choose-card-img', loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 360px, (min-width: 750px) 45vw, 90vw' }}
            {% elsif block.settings.fallback_image != blank %}
              <img class="yn-src-why-choose-card-img" src="{{ block.settings.fallback_image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="600" height="600">
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "YN Why Us",
  "tag": "section",
  "class": "section yoode-new-home-section",
  "settings": [
    {
      "type": "header",
      "content": "Section container"
    },
    {
      "type": "checkbox",
      "id": "custom_container",
      "label": "Customize this section container",
      "default": false,
      "info": "Enable to adjust only this section. Leave off to keep the current responsive layout."
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container type",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid",
          "label": "Container fluid"
        }
      ],
      "default": "container",
      "info": "Container uses the maximum width below. Container fluid fills the available width. Buttons follow this section container."
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Maximum content width",
      "info": "Applies to Container only. Smaller screens use the available width.",
      "min": 800,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 1600
    },
    {
      "type": "range",
      "id": "container_gutter_desktop",
      "label": "Side spacing: 1000px and above",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "container_gutter_tablet",
