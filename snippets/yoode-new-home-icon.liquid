      <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
    {%- when 'file-text' -%}
      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17 17 7M7 7h10v10"/>
    {%- when 'hard-hat' -%}
      <path d="M2 18v-2a4 4 0 0 1 4-4h12a4 4 0 0 1 4 4v2"/><path d="M10 10V5a2 2 0 1 1 4 0v5"/><path d="M14 2H9.5a2.5 2.5 0 0 0 0 5H14"/>
